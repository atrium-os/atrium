// Compute shader for atrium-core's `texture` op.
//
// Mirrors op_rectangle.comp's shape (one thread per scene node;
// atomicAdd into instance counter; write InstanceRecord). The texture
// op only needs a per-instance model rect — the texture binding lives
// in the render pipeline's descriptor set, not here, so each compute
// dispatch is implicitly scoped to one slot.
//
// Step 9 of the POC: fresco-server batches scene nodes by slot_id on
// the host, then issues one dispatch+draw cycle per slot. That's
// simpler than encoding slot_id in InstanceRecord and binding a
// sampler array; future hierarchical traversal can revisit if scenes
// routinely reference > N slots per frame.

#version 460

struct SceneNode {
    vec4 model;       /* x, y, w, h in screen pixels */
};

struct InstanceRecord {
    vec4 model;       /* same shape; render shader generates UVs from
                         vertex index */
};

layout(set = 0, binding = 0) readonly buffer SceneBuf {
    uint       node_count;
    uint       _pad0[3];
    SceneNode  nodes[];
} scene;

layout(set = 0, binding = 1) writeonly buffer InstanceBuf {
    InstanceRecord instances[];
} instance_buf;

layout(set = 0, binding = 2) buffer CounterBuf {
    uint count;
} counter;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= scene.node_count) {
        return;
    }
    uint slot = atomicAdd(counter.count, 1);
    instance_buf.instances[slot].model = scene.nodes[id].model;
}
