// Single-packet AVDTP signalling (AVDTP 1.3 §8) and A2DP SBC capabilities.
// Copyright (c) 2026, Atrium contributors. BSD-2-Clause.
little_endian_packets

packet Signal {
  message_type: 2,
  packet_type: 2,
  label: 4,
  signal_id: 8,
  body: 8[],
}

struct Endpoint {
  reserved: 1,
  in_use: 1,
  seid: 6,
  reserved2: 3,
  sink: 1,
  media_type: 4,
}

packet Discovery {
  endpoints: Endpoint[],
}

struct Capability {
  category: 8,
  _size_(value): 8,
  value: 8[],
}

packet Capabilities {
  list: Capability[],
}

packet SbcCodec {
  media_type: 8,
  codec_type: 8,
  modes: 8,
  blocks: 8,
  minimum: 8,
  maximum: 8,
}
