From 63978b39889f5a8e2034161a180fd5541f60dc5d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 09:17:56 +0000
Subject: [PATCH] kern.rust.mk: amd64 KASAN shadow offset

Patch 0004 set -asan-mapping-offset only for aarch64. On amd64 rustc's
x86_64-unknown-none default (an OR with 0x100000000000) is a user-space
mapping, so the first stack poison in any instrumented Rust function
took a general protection fault. Use clang's FreeBSD kernel offset,
0xdffff7c000000000, which the C kernel is built with.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kern.rust.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/kern.rust.mk b/kern.rust.mk
index 9b385b8..1fe4d9b 100644
--- a/kern.rust.mk
+++ b/kern.rust.mk
@@ -106,6 +106,10 @@ RUSTFLAGS+= -Zsanitizer=kernel-address --cfg kasan \
 	-Cllvm-args=-asan-instrumentation-with-call-threshold=0
 .if ${TARGET_ARCH} == aarch64
 RUSTFLAGS+= -Cllvm-args=-asan-mapping-offset=0xdfff208000000000
+.elif ${TARGET_ARCH} == amd64
+# clang's offset for x86_64-unknown-freebsd kernel-address (what the C kernel uses); rustc's
+# x86_64-unknown-none default is a user-space one and faults on the first stack poison.
+RUSTFLAGS+= -Cllvm-args=-asan-mapping-offset=0xdffff7c000000000
 .endif
 .endif
 
