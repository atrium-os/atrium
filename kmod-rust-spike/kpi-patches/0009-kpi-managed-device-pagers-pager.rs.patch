@@ -283,3 +289,24 @@ rust_bindings_knote_locked(struct knlist *list, long hint) {
     KNOTE_LOCKED(list, hint);
 }
 
+/* Device pagers (kpi/src/pager.rs): the VM object lock and page busy macros. */
+void
+rust_bindings_vm_object_wlock(vm_object_t obj) {
+    VM_OBJECT_WLOCK(obj);
+}
+
+void
+rust_bindings_vm_object_wunlock(vm_object_t obj) {
+    VM_OBJECT_WUNLOCK(obj);
+}
+
+void
+rust_bindings_vm_object_assert_wlocked(vm_object_t obj) {
+    VM_OBJECT_ASSERT_WLOCKED(obj);
+}
+
+void
+rust_bindings_vm_page_xunbusy(vm_page_t m) {
+    vm_page_xunbusy(m);
+}
