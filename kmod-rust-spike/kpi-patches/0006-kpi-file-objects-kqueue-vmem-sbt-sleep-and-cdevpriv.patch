+//! vmem(9) resource arenas: an address range handed out in quantum-sized pieces.
+
+use crate::bindings::{self, vmem_addr_t, vmem_size_t};
+use crate::prelude::*;
+use crate::ErrCode;
+use core::ffi::CStr;
+use core::ptr::NonNull;
+
+/// An arena owned by Rust code. Destroyed (`vmem_destroy`) on drop; every range must have
+/// been freed by then, which `vmem_destroy` checks on INVARIANTS kernels.
+pub struct VmemArena(NonNull<bindings::vmem_t>);
+
+// SAFETY: vmem arenas carry their own lock.
+unsafe impl Send for VmemArena {}
+unsafe impl Sync for VmemArena {}
+
+/// Allocation policy for [`VmemArena::alloc`].
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum Fit {
+    Best,
+    First,
+    /// Next-fit: a freed range comes back only after the cursor has lapped the arena.
+    Next,
+}
+
+impl Fit {
+    fn flag(self) -> core::ffi::c_int {
+        (match self {
+            Fit::Best => bindings::M_BESTFIT,
+            Fit::First => bindings::M_FIRSTFIT,
+            Fit::Next => bindings::M_NEXTFIT,
+        }) as _
+    }
+}
+
+impl VmemArena {
+    /// An arena over `[base, base + size)` handing out multiples of `quantum`. May sleep.
+    pub fn new(name: &'static CStr, base: u64, size: u64, quantum: u64) -> Result<Self> {
+        // SAFETY: plain KPI call; the name is static.
+        let p = unsafe {
+            bindings::vmem_create(
+                name.as_ptr(),
+                base as vmem_addr_t,
+                size as vmem_size_t,
+                quantum as vmem_size_t,
+                0,
+                bindings::M_WAITOK as _,
+            )
+        };
+        NonNull::new(p).map(VmemArena).ok_or(ENOMEM)
+    }
+
+    /// Allocate `size` bytes anywhere, without sleeping.
+    pub fn alloc(&self, size: u64, fit: Fit) -> Result<u64> {
+        let mut addr: vmem_addr_t = 0;
+        let flags = fit.flag() | bindings::M_NOWAIT as core::ffi::c_int;
+        // SAFETY: live arena; addr is written on success.
+        let err = unsafe { bindings::vmem_alloc(self.0.as_ptr(), size as _, flags, &mut addr) };
+        if err != 0 {
+            return Err(ErrCode::from(err));
+        }
+        Ok(addr as u64)
+    }
+
+    /// Allocate exactly `[addr, addr + size)`, without sleeping. `EEXIST` if any of it is taken
+    /// or outside the arena.
+    pub fn alloc_at(&self, addr: u64, size: u64) -> Result<()> {
+        let end = addr.checked_add(size).ok_or(EINVAL)?;
+        let mut got: vmem_addr_t = 0;
+        let flags = (bindings::M_BESTFIT | bindings::M_NOWAIT) as core::ffi::c_int;
+        // SAFETY: live arena; got is written on success.
+        let err = unsafe {
+            bindings::vmem_xalloc(
+                self.0.as_ptr(),
+                size as _,
+                0,
+                0,
+                0,
+                addr as _,
+                end as _,
+                flags,
+                &mut got,
+            )
+        };
+        if err != 0 {
+            return Err(EEXIST);
+        }
+        if got as u64 != addr {
+            // SAFETY: we were just given [got, got + size).
+            unsafe { bindings::vmem_free(self.0.as_ptr(), got, size as _) };
+            return Err(EEXIST);
+        }
+        Ok(())
+    }
+
+    /// Give back a range from `alloc` or `alloc_at`.
+    ///
+    /// # Safety
+    ///
+    /// `[addr, addr + size)` is exactly a range this arena handed out and not yet freed.
+    pub unsafe fn free(&self, addr: u64, size: u64) {
+        unsafe { bindings::vmem_free(self.0.as_ptr(), addr as _, size as _) };
+    }
+}
+
+impl Drop for VmemArena {
+    fn drop(&mut self) {
+        // SAFETY: we own the arena.
+        unsafe { bindings::vmem_destroy(self.0.as_ptr()) };
+    }
+}
