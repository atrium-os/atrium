+//! kqueue(2) sources: a knote list guarded by a [`Mutex`], and the knotes on it.
+//!
+//! A driver object that can be waited on with kevent() embeds a [`SelInfo`], initialises its
+//! knote list with the object's mutex once the object has its final address, and calls
+//! [`SelInfo::knote_locked`] with that mutex held whenever the condition may have changed. The
+//! filter functions the kernel calls (`f_event`, `f_detach`) receive a [`Knote`].
+
+use crate::bindings::{self, filterops, knote};
+use crate::sync::mtx::{Mutex, MutexGuard};
+use core::cell::UnsafeCell;
+use core::ffi::c_long;
+use core::mem::MaybeUninit;
+
+/// A `struct selinfo`: the knote list (and select/poll waiters) of one object.
+pub struct SelInfo {
+    inner: UnsafeCell<bindings::selinfo>,
+    inited: UnsafeCell<bool>,
+}
+
+// SAFETY: every access after init goes through the knlist's own lock.
+unsafe impl Send for SelInfo {}
+unsafe impl Sync for SelInfo {}
+
+impl SelInfo {
+    pub const fn new() -> Self {
+        // SAFETY: an all-zero selinfo is what C drivers get from M_ZERO before knlist_init.
+        Self {
+            inner: UnsafeCell::new(unsafe { MaybeUninit::zeroed().assume_init() }),
+            inited: UnsafeCell::new(false),
+        }
+    }
+
+    /// Initialise the knote list, locked by `lock` (`knlist_init_mtx`).
+    ///
+    /// # Safety
+    ///
+    /// Call once, after `self` and `lock` are at their final addresses (inside a `Box`), with
+    /// `lock` initialised and outliving `self`; neither may move afterwards.
+    pub unsafe fn init_mtx<T>(&self, lock: &Mutex<T>) {
+        unsafe {
+            bindings::knlist_init_mtx(&raw mut (*self.inner.get()).si_note, lock.raw_mtx());
+            *self.inited.get() = true;
+        }
+    }
+
+    /// The `struct knlist`, for `knlist_add`/`knlist_remove` in a filter.
+    pub fn knlist(&self) -> *mut bindings::knlist {
+        // SAFETY: address only.
+        unsafe { &raw mut (*self.inner.get()).si_note }
+    }
+
+    /// Run every knote's `f_event` (`KNOTE_LOCKED`). The guard proves the list's lock is held.
+    pub fn knote_locked<T>(&self, _held: &MutexGuard<'_, T>, hint: c_long) {
+        // SAFETY: the list is initialised (guards exist only for initialised mutexes, and the
+        // caller pairs this SelInfo with that mutex) and its lock is held.
+        unsafe { bindings::rust_bindings_knote_locked(self.knlist(), hint) };
+    }
+
+    /// Add a knote (from `fo_kqfilter`). `islocked`: the list's lock is already held.
+    ///
+    /// # Safety
+    ///
+    /// `kn` is the knote the kernel passed to the kqfilter, with `kn_fop` and `kn_hook` set.
+    pub unsafe fn add(&self, kn: *mut knote, islocked: bool) {
+        unsafe { bindings::knlist_add(self.knlist(), kn, islocked as _) };
+    }
+
+    /// Remove a knote (from `f_detach`).
+    ///
+    /// # Safety
+    ///
+    /// `kn` is on this list.
+    pub unsafe fn remove(&self, kn: *mut knote, islocked: bool) {
+        unsafe { bindings::knlist_remove(self.knlist(), kn, islocked as _) };
+    }
+}
+
+impl Drop for SelInfo {
+    fn drop(&mut self) {
+        // SAFETY: we are the last user; the lock (outliving us, see init_mtx) is still valid.
+        unsafe {
+            if *self.inited.get() {
+                bindings::seldrain(self.inner.get());
+                bindings::knlist_destroy(self.knlist());
+            }
+        }
+    }
+}
+
+/// A knote handed to a filter function.
+pub struct Knote(*mut knote);
+
+impl Knote {
+    /// # Safety
+    ///
+    /// `kn` is a live knote passed by the kernel to a filter function.
+    pub unsafe fn from_raw(kn: *mut knote) -> Self {
+        Knote(kn)
+    }
+
+    pub fn as_ptr(&self) -> *mut knote {
+        self.0
+    }
+
+    /// The filter's own pointer (`kn_hook`), set in the kqfilter.
+    pub fn hook<T>(&self) -> *mut T {
+        unsafe { (*self.0).kn_hook.cast() }
+    }
+
+    /// # Safety
+    ///
+    /// `hook` lives at least until `f_detach`.
+    pub unsafe fn set_ops(&self, ops: &'static FilterOps, hook: *const core::ffi::c_void) {
+        unsafe {
+            (*self.0).kn_fop = &ops.0;
+            (*self.0).kn_hook = hook.cast_mut();
+        }
+    }
+
+    pub fn filter(&self) -> i16 {
+        unsafe { (*self.0).kn_kevent.filter }
+    }
+
+    /// The `data` the caller put in its kevent (`kn_sdata`).
+    pub fn sdata(&self) -> i64 {
+        unsafe { (*self.0).kn_sdata as i64 }
+    }
+
+    /// The `data` returned to the caller (`kn_data`).
+    pub fn set_data(&self, v: i64) {
+        unsafe { (*self.0).kn_kevent.data = v as _ };
+    }
+
+    /// Report end-of-file with `fflags` (an errno, by convention of the source).
+    pub fn set_eof(&self, fflags: u32) {
+        unsafe {
+            (*self.0).kn_kevent.flags |= bindings::EV_EOF as u16;
+            (*self.0).kn_kevent.fflags = fflags;
+        }
+    }
+}
+
+/// A `struct filterops`, for a static.
+#[repr(transparent)]
+pub struct FilterOps(pub filterops);
+
+// SAFETY: immutable function pointers and flags.
+unsafe impl Sync for FilterOps {}
+
+impl FilterOps {
+    /// A descriptor-backed filter (`f_isfd = 1`) with the given detach and event functions and
+    /// the trivial copy.
+    pub const fn fd(
+        detach: unsafe extern "C" fn(*mut knote),
+        event: unsafe extern "C" fn(*mut knote, c_long) -> core::ffi::c_int,
+    ) -> Self {
+        // SAFETY: filterops is function pointers and an int; all-zero is valid.
+        let mut f: filterops = unsafe { MaybeUninit::zeroed().assume_init() };
+        f.f_isfd = 1;
+        f.f_detach = Some(detach);
+        f.f_event = Some(event);
+        f.f_copy = Some(bindings::knote_triv_copy);
+        FilterOps(f)
+    }
+}
