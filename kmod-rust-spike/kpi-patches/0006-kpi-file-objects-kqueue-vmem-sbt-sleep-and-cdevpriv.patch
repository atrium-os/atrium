+
+//! Kernel objects handed to user space as file descriptors (`struct file` with a module's own
+//! `fileops`), the way kqueue, eventfd and DRM-style buffer objects are.
+//!
+//! The lifetime rule is the one C drivers get wrong: the object lives exactly as long as the
+//! `struct file` holds it, and the last `fdrop` runs `fo_close`, which frees it. Here:
+//!
+//! - [`install`] moves a `Box<T>` into a new file and returns the descriptor. From then on the
+//!   file owns it; the `fo_close` that [`file_ops!`] installs takes it back and drops it.
+//! - [`FileRef::get`] resolves a descriptor to a held reference, checks that the file really is a
+//!   `T` (its `f_ops` is `T`'s table), and derefs to `&T`. Dropping it is the `fdrop`, so a
+//!   reference can't be leaked on an error path or used after it is released.
+//!
+//! An object reachable through a `FileRef` is shared (several threads, several processes after
+//! SCM_RIGHTS), so `T` only ever hands out `&T`: mutable state inside it needs a lock.
+
+use crate::bindings::{self, file, fileops, filedesc, kinfo_file, stat, thread, ucred};
+use crate::boxed::Box;
+use crate::prelude::*;
+use crate::ErrCode;
+use core::ffi::c_int;
+use core::marker::PhantomData;
+use core::mem::MaybeUninit;
+use core::ops::Deref;
+use core::ptr::{NonNull, null_mut};
+
+/// A file-operations table, built by [`file_ops!`].
+#[repr(transparent)]
+pub struct FileOps(pub bindings::fileops);
+
+// SAFETY: a fileops table is immutable function pointers and flags.
+unsafe impl Sync for FileOps {}
+
+/// A kernel object that lives in a `struct file`.
+///
+/// # Safety
+///
+/// `fileops()` must return a table made by [`file_ops!`] for this same type and used for no
+/// other type: its `fo_close` frees `f_data` as a `Box<Self>`, and [`FileRef::get`] trusts the
+/// table's identity to know what `f_data` points to.
+pub unsafe trait FileObject: Send + Sync + Sized + 'static {
+    fn fileops() -> &'static FileOps;
+}
+
+/// The calling thread.
+pub fn curthread() -> *mut thread {
+    unsafe { bindings::rust_bindings_curthread() }
+}
+
+/// `fo_close` for a [`FileObject`]: take the object out of the file and drop it.
+///
+/// # Safety
+///
+/// Called by the kernel only, through a table from [`file_ops!`] for `T`.
+pub unsafe extern "C" fn close_trampoline<T: FileObject>(fp: *mut file, _td: *mut thread) -> c_int {
+    // SAFETY: the kernel passes the file being closed; nobody else holds a reference to it.
+    let data = unsafe { core::mem::replace(&mut (*fp).f_data, null_mut()) };
+    if !data.is_null() {
+        // SAFETY: f_data was set by `install::<T>` from `Box::into_raw`.
+        drop(unsafe { Box::<T>::from_raw(data.cast::<T>()) });
+    }
+    0
+}
+
+/// `fo_stat`: a character-device-like object with no other attributes.
+pub unsafe extern "C" fn stat_chr(_fp: *mut file, sb: *mut stat, _cred: *mut ucred) -> c_int {
+    // SAFETY: the kernel passes a stat buffer to fill.
+    unsafe {
+        core::ptr::write_bytes(sb, 0, 1);
+        (*sb).st_mode = bindings::S_IFCHR as _;
+    }
+    0
+}
+
+/// `fo_fill_kinfo`: report the object as a device.
+pub unsafe extern "C" fn fill_kinfo_dev(
+    _fp: *mut file,
+    kif: *mut kinfo_file,
+    _fdp: *mut filedesc,
+) -> c_int {
+    // SAFETY: the kernel passes a kinfo_file to fill.
+    unsafe { (*kif).kf_type = bindings::KF_TYPE_DEV as _ };
+    0
+}
+
+/// The defaults [`file_ops!`] starts from: no read/write/ioctl/poll/kqueue, character-device
+/// stat, passable over a unix socket, and the `fo_close` that frees the object.
+pub const fn default_fileops<T: FileObject>() -> fileops {
+    // SAFETY: fileops is function pointers (None) and integers; all-zero is valid.
+    let mut ops: fileops = unsafe { MaybeUninit::zeroed().assume_init() };
+    ops.fo_read = Some(bindings::invfo_rdwr);
+    ops.fo_write = Some(bindings::invfo_rdwr);
+    ops.fo_truncate = Some(bindings::invfo_truncate);
+    ops.fo_ioctl = Some(bindings::invfo_ioctl);
+    ops.fo_poll = Some(bindings::invfo_poll);
+    ops.fo_kqfilter = Some(bindings::invfo_kqfilter);
+    ops.fo_stat = Some(stat_chr);
+    ops.fo_close = Some(close_trampoline::<T>);
+    ops.fo_chmod = Some(bindings::invfo_chmod);
+    ops.fo_chown = Some(bindings::invfo_chown);
+    ops.fo_sendfile = Some(bindings::invfo_sendfile);
+    ops.fo_fill_kinfo = Some(fill_kinfo_dev);
+    ops.fo_cmp = Some(bindings::file_kcmp_generic);
+    ops.fo_flags = bindings::DFLAG_PASSABLE as _;
+    ops
+}
+
+/// Define the `fileops` table of a [`FileObject`] and implement the trait.
+///
+/// ```ignore
+/// file_ops!(SyncObj);                                      // defaults only
+/// file_ops!(SyncObj, |ops| { ops.fo_kqfilter = Some(my_kqfilter); });
+/// ```
+#[macro_export]
+macro_rules! file_ops {
+    ($ty:ty) => {
+        $crate::file_ops!($ty, |_ops| {});
+    };
+    ($ty:ty, |$ops:ident| $body:block) => {
+        const _: () = {
+            static OPS: $crate::file::FileOps = $crate::file::FileOps({
+                #[allow(unused_mut)]
+                let mut $ops = $crate::file::default_fileops::<$ty>();
+                $body
+                // Whatever the body did, fo_close is the one that frees a Box<$ty>.
+                $ops.fo_close = Some($crate::file::close_trampoline::<$ty>);
+                $ops
+            });
+            // SAFETY: OPS is this type's own table and its fo_close frees a Box<$ty>.
+            unsafe impl $crate::file::FileObject for $ty {
+                fn fileops() -> &'static $crate::file::FileOps {
+                    &OPS
+                }
+            }
+        };
+    };
+}
+
+/// Give `obj` to a new file and install it in the calling process's descriptor table.
+/// `fflags` are the file's `f_flag` (FREAD, FWRITE). Returns the descriptor.
+pub fn install<T: FileObject>(obj: Box<T>, fflags: c_int) -> Result<c_int> {
+    let td = curthread();
+    let mut fp: *mut file = null_mut();
+    // SAFETY: plain KPI call; fp is written on success.
+    let err = unsafe { bindings::_falloc_noinstall(td, &mut fp, 1) };
+    if err != 0 {
+        return Err(ErrCode::from(err)); // obj dropped here
+    }
+    let ops = core::ptr::from_ref(&T::fileops().0).cast_mut();
+    // SAFETY: fp is a fresh file we hold the only reference to; from here the file owns the
+    // object, and its fo_close (close_trampoline::<T>) frees it.
+    unsafe {
+        bindings::finit(fp, fflags as _, bindings::DTYPE_DEV as _, Box::into_raw(obj).cast(), ops)
+    };
+    let mut fd: c_int = -1;
+    // SAFETY: fp is initialised; finstall takes its own reference on success.
+    let err = unsafe { bindings::finstall(td, fp, &mut fd, 0, null_mut()) };
+    // Our allocation reference: on failure this is the last one, and fo_close frees the object.
+    unsafe { bindings::rust_bindings_fdrop(fp, td) };
+    if err != 0 {
+        return Err(ErrCode::from(err));
+    }
+    Ok(fd)
+}
+
+/// A held reference to a file that holds a `T`. Derefs to the object; drop releases the file.
+pub struct FileRef<T: FileObject> {
+    fp: NonNull<file>,
+    _t: PhantomData<T>,
+}
+
+// SAFETY: the file reference is a refcount; T is Sync, so &T may go to other threads.
+unsafe impl<T: FileObject> Send for FileRef<T> {}
+unsafe impl<T: FileObject> Sync for FileRef<T> {}
+
+impl<T: FileObject> FileRef<T> {
+    /// Resolve a descriptor of the calling process. `EBADF` if it isn't open, `EINVAL` if it is
+    /// not a `T`.
+    pub fn get(fd: c_int) -> Result<Self> {
+        let td = curthread();
+        let mut rights = MaybeUninit::<bindings::cap_rights_t>::uninit();
+        let mut fp: *mut file = null_mut();
+        // SAFETY: rights is initialised (no rights required) before fget reads it.
+        let err = unsafe {
+            bindings::rust_bindings_cap_rights_init_none(rights.as_mut_ptr());
+            bindings::fget(td, fd, rights.as_mut_ptr(), &mut fp)
+        };
+        if err != 0 {
+            return Err(ErrCode::from(err));
+        }
+        let r = FileRef::<T> { fp: NonNull::new(fp).ok_or(EBADF)?, _t: PhantomData };
+        // SAFETY: we hold a reference, so the file is live.
+        let (ops, data) = unsafe { ((*fp).f_ops, (*fp).f_data) };
+        if !core::ptr::eq(ops, &T::fileops().0) {
+            return Err(EINVAL); // r drops the reference
+        }
+        if data.is_null() {
+            return Err(EBADF);
+        }
+        Ok(r)
+    }
+
+    /// The `struct file`, for C code that keeps its own reference or compares identity.
+    pub fn as_file_ptr(&self) -> *mut file {
+        self.fp.as_ptr()
+    }
+
+    /// Hand the reference to C code, which releases it with `fdrop(fp, td)`.
+    pub fn into_raw(self) -> *mut file {
+        let fp = self.fp.as_ptr();
+        core::mem::forget(self);
+        fp
+    }
+
+    /// The object, as the raw pointer C code knows it by.
+    pub fn as_ptr(&self) -> *mut T {
+        // SAFETY: a held, type-checked file with non-NULL f_data (checked in get()).
+        unsafe { (*self.fp.as_ptr()).f_data.cast::<T>() }
+    }
+}
+
+impl<T: FileObject> Deref for FileRef<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        // SAFETY: f_data stays set until fo_close, which runs only after the last reference
+        // (including ours) is dropped.
+        unsafe { &*self.as_ptr() }
+    }
+}
+
+impl<T: FileObject> Clone for FileRef<T> {
+    fn clone(&self) -> Self {
+        // SAFETY: we hold a reference, so the count is non-zero and fhold can't fail except on
+        // overflow, which the kernel refuses rather than wrapping.
+        let ok = unsafe { bindings::rust_bindings_fhold(self.fp.as_ptr()) };
+        assert!(ok, "file reference count overflow");
+        FileRef { fp: self.fp, _t: PhantomData }
+    }
+}
+
+impl<T: FileObject> Drop for FileRef<T> {
+    fn drop(&mut self) {
+        // SAFETY: we own one reference.
+        unsafe { bindings::rust_bindings_fdrop(self.fp.as_ptr(), curthread()) };
+    }
+}
