+/// Per-open driver state (`devfs_set_cdevpriv(9)`): one `T` per open file of a cdev, dropped
+/// when the last reference to that open file goes away.
+///
+/// # Safety
+///
+/// Every `d_open` of the cdevs this type is used with sets a `T` and nothing else, so that
+/// [`with_cdevpriv`] may read the per-open pointer as a `T`.
+pub unsafe trait CdevPriv: Send + Sync + Sized + 'static {}
+
+unsafe extern "C" fn cdevpriv_dtor<T: CdevPriv>(p: *mut core::ffi::c_void) {
+    // SAFETY: set by set_cdevpriv::<T> from Box::into_raw.
+    drop(unsafe { crate::boxed::Box::<T>::from_raw(p.cast::<T>()) });
+}
+
+/// Attach `priv_` to the open in progress (call from `d_open`).
+pub fn set_cdevpriv<T: CdevPriv>(priv_: crate::boxed::Box<T>) -> Result<()> {
+    let p = crate::boxed::Box::into_raw(priv_);
+    // SAFETY: plain KPI call; on success devfs owns p and frees it through the dtor.
+    let err = unsafe { bindings::devfs_set_cdevpriv(p.cast(), Some(cdevpriv_dtor::<T>)) };
+    if err != 0 {
+        // SAFETY: devfs did not take it.
+        drop(unsafe { crate::boxed::Box::<T>::from_raw(p) });
+        return Err(ErrCode::from(err));
+    }
+    Ok(())
+}
+
+/// Run `f` on the current open's state (from `d_ioctl`, `d_mmap_single`, ...). The reference
+/// can't leave `f`: the state lives only as long as the thread's hold on the open file.
+pub fn with_cdevpriv<T: CdevPriv, R>(f: impl FnOnce(&T) -> R) -> Result<R> {
+    let mut p: *mut core::ffi::c_void = core::ptr::null_mut();
+    // SAFETY: plain KPI call.
+    let err = unsafe { bindings::devfs_get_cdevpriv(&mut p) };
+    if err != 0 {
+        return Err(ErrCode::from(err));
+    }
+    // SAFETY: CdevPriv's contract: the pointer is a T, live during this call.
+    Ok(f(unsafe { &*p.cast::<T>() }))
+}
