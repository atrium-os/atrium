[package]
name = "navigator-ladybird-painter"
version = "0.1.0"
edition = "2024"
publish = false

[features]
editor = ["dep:navigator-forms", "dep:nuntius", "dep:libxml_rust", "dep:libweb_bindings_rust", "dep:libweb_rust", "dep:limen", "dep:fresco-client", "dep:fresco-protocol"]

[lib]
crate-type = ["rlib", "staticlib"]
path = "@CMAKE_CURRENT_SOURCE_DIR@/painter.rs"

[dependencies]
navigator-forms = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../navigator-page/forms", optional = true }
pergola = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../pergola" }
libcompositing_rust = { path = "@LADYBIRD_SOURCE@/Libraries/LibCompositing/Rust", default-features = false }
libgfx_rust = { path = "@LADYBIRD_SOURCE@/Libraries/LibGfx/Rust", default-features = false }
libweb_rust = { path = "@LADYBIRD_SOURCE@/Libraries/LibWeb/Rust", default-features = false, optional = true }
libweb_bindings_rust = { path = "@LADYBIRD_SOURCE@/Libraries/LibWeb/Bindings/Rust", default-features = false, optional = true }
limen = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../limen", optional = true }
fresco-client = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../fresco-client", optional = true }
fresco-protocol = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../fresco-protocol", optional = true }
libxml_rust = { path = "@LADYBIRD_SOURCE@/Libraries/LibXML/Rust", default-features = false, optional = true }
nuntius = { path = "@CMAKE_CURRENT_SOURCE_DIR@/../nuntius", default-features = false, optional = true }
