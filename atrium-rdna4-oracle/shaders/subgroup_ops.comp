#version 450
// Subgroup operations on two full waves (64 invocations), then the same
// under divergent control flow. Checked against the GIR interpreter's
// 32-lane subgroup semantics. Compile: glslangValidator -V --target-env vulkan1.1
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer In { uint data[]; };
layout(set = 0, binding = 1) buffer Out { uint o[]; };
void main() {
    uint i = gl_LocalInvocationIndex;
    uint x = data[i];
    uint b = i * 16u;
    o[b + 0u] = subgroupAdd(x);
    o[b + 1u] = subgroupInclusiveAdd(x);
    o[b + 2u] = subgroupExclusiveMax(x);
    o[b + 3u] = subgroupBallot(x > 3u).x;
    o[b + 4u] = subgroupBroadcastFirst(x * 3u);
    o[b + 5u] = subgroupBroadcast(x + i, 5u);
    o[b + 6u] = subgroupShuffle(x + i, (gl_SubgroupInvocationID * 7u) & 31u);
    // Up/down past the subgroup edge is undefined (ds_bpermute wraps), so
    // the edge lanes' results are masked off with arithmetic, not a branch.
    uint up = subgroupShuffleUp(i, 1u) * uint(gl_SubgroupInvocationID >= 1u);
    uint down = subgroupShuffleDown(i, 1u) * uint(gl_SubgroupInvocationID <= 30u);
    o[b + 7u] = subgroupShuffleXor(x + i, 1u) + up * 1000u + down * 100000u;
    o[b + 8u] = (subgroupElect() ? 1u : 0u) + (subgroupAll(x < 7u) ? 2u : 0u) + (subgroupAny(x == 6u) ? 4u : 0u) + (subgroupAllEqual(x) ? 8u : 0u) + (subgroupAllEqual(i / 64u) ? 16u : 0u);
    o[b + 9u] = gl_SubgroupInvocationID + 100u * gl_SubgroupID + 10000u * gl_NumSubgroups + 1000000u * gl_SubgroupSize;
    o[b + 10u] = floatBitsToUint(subgroupAdd(float(x)) + subgroupMax(float(i)) * 0.5);
    o[b + 11u] = subgroupMin(x + 10u) + subgroupOr(1u << x) * 100u + subgroupXor(x) * 100000u;
    o[b + 12u] = uint(subgroupMul(int(x & 3u) + 1)) ^ uint(subgroupExclusiveMin(int(x) - 3)) ^ subgroupAnd(x | 8u);
    if ((x & 1u) == 0u) {
        o[b + 13u] = subgroupAdd(x) + subgroupBallot(true).x;
        o[b + 14u] = subgroupExclusiveAdd(i) + (subgroupElect() ? 1000000u : 0u);
        o[b + 15u] = subgroupBroadcastFirst(i) + subgroupShuffleXor(i, 2u) * 1000u;
    }
}
