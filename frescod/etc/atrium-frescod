#!/bin/sh
# PROVIDE: atrium_frescod
# REQUIRE: FILESYSTEMS atrium_jaild
# KEYWORD: shutdown
#
# atrium-frescod — the Fresco display / scene server (a system service:
# the seat-shared compositor every session app connects to). Listens on the
# canonical in-jail socket paths so jailed apps (with the graphics cap mount)
# reach it.
#
# Spec: docs/spec/forum.md, docs/spec/login-handoff.md.
#
# Add to /etc/rc.conf:
#   atrium_frescod_enable="YES"
#
# Optional:
#   atrium_frescod_sock="/atrium/sockets/fresco/fresco.sock"
#   atrium_frescod_wm_sock="/atrium/sockets/fresco-wm/fresco-wm.sock"
#   atrium_frescod_bundle="/usr/local/share/atrium/bundles/atrium-core"
#   atrium_frescod_headless_png="<base>"   # set on a host with NO display
#                                          # device (frescod then renders to
#                                          # <base>.png instead of scanout)
#   atrium_frescod_logfile="/var/log/atrium/frescod.log"
#   atrium_frescod_log_level="info"

. /etc/rc.subr

name="atrium_frescod"
desc="Atrium Fresco display server"
rcvar="${name}_enable"

load_rc_config "$name"

: ${atrium_frescod_enable:="NO"}
: ${atrium_frescod_sock:="/atrium/sockets/fresco/fresco.sock"}
: ${atrium_frescod_wm_sock:="/atrium/sockets/fresco-wm/fresco-wm.sock"}
: ${atrium_frescod_bundle:="/usr/local/share/atrium/bundles/atrium-core"}
: ${atrium_frescod_headless_png:=""}
: ${atrium_frescod_logfile:="/var/log/atrium/frescod.log"}
: ${atrium_frescod_log_level:="info"}

command="/usr/local/bin/frescod"
pidfile="/var/run/atrium/frescod.pid"
start_cmd="atrium_frescod_start"

atrium_frescod_start() {
    install -d -m 0755 -o root -g wheel /var/run/atrium /var/log/atrium
    # The canonical per-service socket dirs the jail mounts (and forum-wm /
    # the chrome) expect.
    install -d -m 0755 -o root -g wheel \
        /atrium/sockets/fresco /atrium/sockets/fresco-wm \
        /atrium/sockets/forum-ctl /atrium/sockets/notify
    [ -x "${command}" ] || err 1 "${command} not installed"

    # FRESCOD_HEADLESS_PNG, only if configured (a host with no display device).
    _hp=""
    [ -n "${atrium_frescod_headless_png}" ] && _hp="FRESCOD_HEADLESS_PNG=${atrium_frescod_headless_png}"

    # Clear any stale socket from a prior boot so a dependent's readiness probe
    # can't connect-then-fail on a dead file (frescod also unlinks+rebinds, but
    # removing it here closes the window). Readiness itself is gated downstream:
    # ostiarius connect-probes frescod before it launches the login UI (a socket
    # *existing* isn't *connectable*, so a stat-style wait here wouldn't suffice).
    rm -f "${atrium_frescod_sock}" "${atrium_frescod_wm_sock}"

    echo "Starting ${name}."
    /usr/sbin/daemon -f -p "${pidfile}" -o "${atrium_frescod_logfile}" -t "${name}" \
        env RUST_LOG="${atrium_frescod_log_level}" \
            FRESCOD_SOCK="${atrium_frescod_sock}" \
            FRESCOD_WM_SOCK="${atrium_frescod_wm_sock}" \
            FRESCOD_BUNDLE="${atrium_frescod_bundle}" \
            ${_hp} \
            "${command}"
}

run_rc_command "$1"
