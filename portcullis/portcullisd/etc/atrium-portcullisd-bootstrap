#!/bin/sh
# PROVIDE: atrium_portcullisd_bootstrap
# REQUIRE: FILESYSTEMS atrium_jaild atrium_volumes atrium_portcullisd_daemon
# KEYWORD: shutdown
#
# atrium-portcullisd-bootstrap — system-service launcher and
# supervisor. Reads /etc/atrium/services.d/*.toml, asks jaild to
# launch each enabled exec'd service, and supervises restart per
# the manifest's `[supervision]` policy via kqueue +
# EVFILT_PROCDESC.
#
# Spec: docs/spec/portcullis.md, docs/spec/storage.md.
#
# Add to /etc/rc.conf:
#   atrium_portcullisd_bootstrap_enable="YES"
#
# Optional:
#   atrium_portcullisd_bootstrap_jaild_socket="/var/run/atrium/jaild.sock"
#   atrium_portcullisd_bootstrap_volumes_socket="/var/run/atrium/atrium-volumes.sock"
#   atrium_portcullisd_bootstrap_services_dir="/etc/atrium/services.d"
#   atrium_portcullisd_bootstrap_logfile="/var/log/atrium/portcullisd-bootstrap.log"
#   atrium_portcullisd_bootstrap_log_level="info"
#
# This is the *supervised* (long-running) mode. For one-shot
# launches (e.g. CI smoke tests), invoke the binary directly with
# `--once`; rc.d only runs the production supervised path.

. /etc/rc.subr

name="atrium_portcullisd_bootstrap"
desc="Atrium service supervisor (kqueue + EVFILT_PROCDESC)"
rcvar="${name}_enable"

load_rc_config "$name"

: ${atrium_portcullisd_bootstrap_enable:="NO"}
: ${atrium_portcullisd_bootstrap_jaild_socket:="/var/run/atrium/jaild.sock"}
: ${atrium_portcullisd_bootstrap_volumes_socket:="/var/run/atrium/atrium-volumes.sock"}
: ${atrium_portcullisd_bootstrap_services_dir:="/etc/atrium/services.d"}
: ${atrium_portcullisd_bootstrap_logfile:="/var/log/atrium/portcullisd-bootstrap.log"}
: ${atrium_portcullisd_bootstrap_log_level:="info"}

command="/usr/local/bin/atrium-portcullisd-bootstrap"
# --volumes-socket is appended in start_cmd: storage is optional,
# so the value is resolved at start time (see autodetect below).
command_args="--socket ${atrium_portcullisd_bootstrap_jaild_socket} \
              --services-dir ${atrium_portcullisd_bootstrap_services_dir}"
pidfile="/var/run/atrium/portcullisd-bootstrap.pid"

start_cmd="atrium_portcullisd_bootstrap_start"
stop_cmd="atrium_portcullisd_bootstrap_stop"
status_cmd="atrium_portcullisd_bootstrap_status"

atrium_portcullisd_bootstrap_prepare_dirs() {
    install -d -m 0755 -o root -g wheel /var/run/atrium
    install -d -m 0755 -o root -g wheel /var/log/atrium
    install -d -m 0755 -o root -g wheel "${atrium_portcullisd_bootstrap_services_dir}"
}

atrium_portcullisd_bootstrap_start() {
    atrium_portcullisd_bootstrap_prepare_dirs

    if [ ! -S "${atrium_portcullisd_bootstrap_jaild_socket}" ]; then
        err 1 "jaild socket missing; is atrium_jaild running?"
    fi

    # Storage (atrium-volumes) is OPTIONAL. The memory governors and
    # session apps don't need it; only services that declare volumes
    # do. If the socket is configured empty/NO/none, or the configured
    # path doesn't exist, run without storage (pass an empty
    # --volumes-socket, which the bootstrap binary treats as "no
    # volume backend"). Only services that actually request a volume
    # will then fail — by design.
    _vol="${atrium_portcullisd_bootstrap_volumes_socket}"
    case "${_vol}" in
        ""|NO|no|none|NONE)
            _vol="" ;;
        *)
            if [ ! -S "${_vol}" ]; then
                warn "atrium-volumes socket ${_vol} missing; starting without storage"
                _vol=""
            fi ;;
    esac

    echo "Starting ${name}."
    /usr/sbin/daemon -f -p "${pidfile}" \
        -o "${atrium_portcullisd_bootstrap_logfile}" \
        -t "${name}" \
        env RUST_LOG="${atrium_portcullisd_bootstrap_log_level}" \
        "${command}" ${command_args} --volumes-socket "${_vol}"
}

atrium_portcullisd_bootstrap_stop() {
    if [ ! -s "${pidfile}" ]; then
        echo "${name} not running (no pidfile)."
        return 0
    fi
    pid=$(cat "${pidfile}")
    echo "Stopping ${name}."
    # SIGTERM the supervisor; it doesn't yet have a graceful-
    # shutdown handler (V1 — would walk services, RemoveJail +
    # unmount each, then exit). For now SIGTERM kills the
    # process; held procdescs close → exec'd jails with
    # persist=0 die. Any host-namespace mounts they applied
    # leak until atrium_jaild restarts and runs orphan
    # reconciliation, OR the operator umounts manually.
    kill -TERM "${pid}" 2>/dev/null
    for _ in 1 2 3 4 5; do
        if kill -0 "${pid}" 2>/dev/null; then sleep 1; else break; fi
    done
    if kill -0 "${pid}" 2>/dev/null; then
        echo "Force-killing ${name}."
        kill -KILL "${pid}" 2>/dev/null
    fi
    rm -f "${pidfile}"
}

atrium_portcullisd_bootstrap_status() {
    if [ -s "${pidfile}" ] && kill -0 "$(cat "${pidfile}")" 2>/dev/null; then
        echo "${name} is running as pid $(cat "${pidfile}")."
        return 0
    fi
    echo "${name} is not running."
    return 1
}

run_rc_command "$1"
