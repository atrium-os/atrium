#!/bin/sh
# atrium-login — login wrapper that drops the user into a session jail.
#
# Install this at /usr/local/bin/atrium-login (mode 0755), then set
# affected users' shell field in /etc/master.passwd to it:
#
#   pw usermod alice -s /usr/local/bin/atrium-login
#   cap_mkdb /etc/login.conf
#
# login(1)/sshd then exec this on successful auth; we exec
# atrium-session enter, which idempotently creates the per-user
# session jail and jexec's zsh into it.
#
# Dev escape hatch: keep an unaffected dev account (e.g. `dev`) with
# its shell still set to /bin/sh so you can always log in to the host
# without the jail layer.

set -e

# Note: when sshd or login(1) invokes a user's shell, it has ALREADY
# setuid'd to that user. So this script runs as the unprivileged user,
# not as root. atrium-session is installed setuid root and handles the
# privilege escalation internally for the privileged steps (mount +
# jail -c), then drops back to the user via `jexec -l -U`.

# Required: the user we're logging in as. sshd/login set $USER; if
# someone runs this manually without it set, fall back to /bin/sh
# rather than guess.
if [ -z "${USER:-}" ]; then
    echo "atrium-login: \$USER unset; refusing to enter session jail" >&2
    exec /bin/sh -l "$@"
fi

# wait_for_socket: portcullisd may still be coming up at boot.
# We give it 5s; if it never shows, fall through to the host shell
# (degraded mode — better than the user being locked out entirely).
SOCK=/atrium/sockets/portcullis.sock
i=0
while [ $i -lt 50 ] && [ ! -S "$SOCK" ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ ! -S "$SOCK" ]; then
    echo "atrium-login: portcullisd not ready ($SOCK absent), dropping to /bin/sh" >&2
    exec /bin/sh -l "$@"
fi

# atrium-session is installed setuid root so it can do the privileged
# parts (mount nullfs/unionfs, jail -c) before dropping back to the
# user via `jexec -l -U`.
exec /usr/local/bin/atrium-session enter "$USER"
