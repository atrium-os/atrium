#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Data { float v[]; } d;
void main() {
    uint i = gl_GlobalInvocationID.x;
    /* Diagnostic: write 42.0 to every element, ignoring input.
     * Distinguishes "GPU ran but writes didn't propagate" from
     * "GPU never executed the compute shader at all". */
    d.v[i] = 42.0;
}
