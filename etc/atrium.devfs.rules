# Atrium devfs rulesets — installed as /usr/local/etc/atrium/devfs.rules and
# listed in rc.conf's devfs_rulesets, so rc.d/devfs loads it at every boot.
# (scripts/bootstrap-atrium.sh does both.)
#
# ★★★ A RULESET THAT IS NOT LOADED HIDES NOTHING. Mounting devfs with a ruleset
# number the kernel has never been given succeeds, and the kernel quietly
# creates an EMPTY ruleset for it — so the jail sees the host's entire /dev.
# Measured 2026-09-22: ruleset 99 (every portcullis app + one-shot worker), 20
# (memoryd/memfed) and 21 (frescod) were all unloaded — 20 and 21 each had an
# "append this to /etc/devfs.rules by hand" file that nothing ever did, and 99
# was a placeholder with no definition at all — and a jail on any of them
# saw 64 host nodes: mem, kmem, bpf, pci, devctl and the raw disks. A process
# running as root inside such a jail read the host's disk directly.
# jaild and portcullis now REFUSE to create a jail whose ruleset has no rules,
# so forgetting this file fails loudly instead of silently exposing /dev.
#
# The numeric ids must match jaild.policy.toml [devfs_rulesets].allowed_ids.

# The jailed memory governor (atrium-memoryd / atrium-memfed): the basics plus
# /dev/pressure, readable (0644) inside the jail's own devfs so the non-root
# governor uid can open it for PRESSURE_GET and the kqueue edge. The host's
# /dev/pressure stays 0640 root:wheel.
[atrium_governor=20]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path pressure unhide
add path pressure mode 0644

# GPU, no display. Baseline plus the GPU node, made openable (0666) inside the
# jail's own devfs instance so a non-root uid can use it. No input nodes: input
# comes from tactusd (atrium_input=26). The atrium-gpu-amd kmod gates only on
# node permissions (no priv_check), so this grant alone lets frescod run without
# root. atrium-gpu0ctl (device reset, scheduler, power gating) is deliberately
# NOT unhidden here or in any jail ruleset: it is the host broker's alone. The host's nodes stay 0600 root:wheel — these rules change only this
# jail's devfs mount.
# Not on jaild's allow-list (jaild.policy.toml allowed_ids): no service uses it.
[atrium_gpu=21]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'atrium-gpu0' unhide
add path 'atrium-gpu0' mode 0666

# The jailed, NON-ROOT compositor (frescod): atrium_gpu plus the display. This
# ruleset is frescod's alone: jaild.policy.toml pins id 23 to the frescod
# service (jail atrium-frescod, /usr/local/bin/atrium-frescod, uid _frescod),
# and the display driver additionally refuses any opener but the jail and uid
# named in its lease, which jaild writes before frescod starts.
[atrium_display=23]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'atrium-gpu0' unhide
add path 'atrium-gpu0' mode 0666
add path 'atrium-display0' unhide
add path 'atrium-display0' mode 0666

# The jailed, NON-ROOT audio engine (lyrad, lyra-v1.md §3): the sound card
# (dsp*, mixer*) and the deadline lane, openable inside this jail's own devfs.
# lyrad's alone: jaild.policy.toml pins id 24 to the lyrad service (jail
# atrium-lyrad, /usr/local/bin/atrium-lyrad, uid _lyra). No app jail ever shows
# dsp* or mixer*: apps play through choragusd (portcullis apply_audio).
# dsp*/mixer* are shown to lyrad per card by atrium-dispensatord
# (lyra/etc/devices.d/35-lyra.toml); here only their mode.
[atrium_audio=24]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'dsp*' mode 0666
add path 'mixer*' mode 0666
add path 'laminar' unhide
add path 'laminar' mode 0666

# Every portcullis app and one-shot worker: hide the whole host /dev, then the
# nodes any process needs (null/zero/random, the pty/fd set). Capabilities add
# to this PER JAIL — portcullis applies each capability's unhide rules to that
# jail's own devfs mount — so this ruleset never grows to fit one app.
[atrium_app=22]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add include $devfsrules_unhide_login

# The jailed, NON-ROOT input service (tactusd, atrium-input.md §2): the i8042
# PS/2 keyboard and pointer (atkbd*; bpsm*, psm's blocking node; tactus-console
# hands atkbd0 over from the console's kbdmux), openable inside this jail's own
# devfs. tactusd's alone (jaild.policy.toml pins id 26); frescod's rulesets show
# no input nodes.
#
# HID nodes (hidraw*, USB and I2C devices through hidbus) are NOT unhidden here
# (sigillum.md §5.1): a security key is a HID device too, and tactusd must not
# be able to open it. portcullisd's identity-device agent reads the kernel's
# classification of each device from devd and shows tactusd the input ones,
# one node at a time, in tactusd's own mount (`devfs -m ... rule apply`); a
# node nobody classified stays hidden. The mode rule still applies to hidden
# nodes, so an unhidden one is openable by _tactus.
# hidraw*, atkbd* and bpsm* are shown to tactusd per device by
# atrium-dispensatord (tactus/etc/devices.d/30-tactus.toml); here only their mode.
[atrium_input=26]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'hidraw*' mode 0666
add path 'atkbd*' mode 0666
add path 'bpsm*' mode 0666

# Sigillum's per-device driver jails (sigillum.md §4): the basics and nothing
# else. Each jail is shown its own one device by jaild (the request's
# devfs_grant, checked against the pin in jaild.policy.toml: id 27,
# atrium-sigillum-fido-*, _sigillum-dev), owned by _sigillum-dev, 0600.
[atrium_identity=27]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic

# Capsa's removable-storage servers (device-assignment.md §4.6): the basics
# and nothing else. jaild opens the partition and /dev/fuse for each and
# passes them as descriptors; no disk node is ever shown in the jail.
[atrium_capsa=31]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic

# Aura, the Wi-Fi stack (wifi.md §8.3): each daemon sees only its own node
# of each radio. aura-mlme gets the control nodes (scans, management
# frames), never key*; aura-keys gets the key nodes (EAPOL, keys, the
# controlled port), never ctl*. Each ruleset is pinned to its jail and uid in
# jaild.policy.toml (28 atrium-aura-mlme/_aura, 29 atrium-aura-keys/_aura-keys).
[atrium_wifi_mlme=28]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'aura' unhide
add path 'aura/ctl*' unhide
add path 'aura/ctl*' mode 0600 user _aura

[atrium_wifi_keys=29]
add include $devfsrules_hide_all
add include $devfsrules_unhide_basic
add path 'aura' unhide
add path 'aura/key*' unhide
add path 'aura/key*' mode 0600 user _aura-keys
