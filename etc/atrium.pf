# Atrium pf base ruleset — per-app network isolation (docs/spec/network.md §0).
#
# Installed as /usr/local/etc/atrium/pf.conf and loaded at boot (pf_enable,
# pf_rules, gateway_enable) by scripts/bootstrap-atrium.sh and
# scripts/deploy-portcullis.sh.
#
# NAT goes out whichever interface is in group `atrium_egress`: atrium-net
# keeps the egress interface (the one with the default route) alone in it,
# so apps follow a move from Ethernet to Wi-Fi with no pf reload
# (atrium-net.md §7.2). Without atrium-net, the install scripts put the
# default-route interface in the group at every boot (/etc/start_if.<if>).
#
# Every networked app sits on its own point-to-point /30 from 100.64.0.0/16;
# the host end of each app's epair is in interface group `atrium`.
#
# ★★ The blocks are LOAD-BEARING: measured without them, an app reached the
# host's sshd through its own gateway address. jaild refuses to create a
# networked jail unless the host block, the anchor point and the final block
# are all loaded (jaild/src/routed.rs isolation_loaded).
set skip on lo0
# VPN tunnels (docs/spec/vpn.md §5): atrium-net loads atrium/vpn with each
# up tunnel's nat (apps' traffic it carries leaves as the tunnel's address),
# so it comes before the egress nat. Its filter rules ride on "atrium/*".
nat-anchor "atrium/vpn"
# A persona's tunnel (vpn.md §5.5): its apps' DNS, wherever they send it,
# goes to the tunnel's servers (rdr pass, so the host block below never
# sees it). The apps are in table <atrium_fib_N>, kept by jaild.
rdr-anchor "atrium/vpn"
nat on atrium_egress inet from 100.64.0.0/16 to any -> (atrium_egress:0)

# An app never reaches the host itself — any of the host's addresses. First,
# so no per-app grant can undo it.
block in quick on atrium inet from any to (self)
# Each networked app's grants, rendered by jaild from structured grants
# (network.md §0.1): consented peers, then that app's own block to
# 100.64.0.0/16, then its outbound passes. All `quick`.
anchor "atrium/*"
# Everything else from an app: denied — including other apps.
block in quick on atrium
# An app's own address never leaves by the egress: replies for a jail that
# is gone (a VPN engine's, after down) would otherwise follow the default
# route out un-NATed (vpn.md §5.4, seen in the V2 gate).
block out quick on atrium_egress inet from any to 100.64.0.0/16

pass all
