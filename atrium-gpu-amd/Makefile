# atrium-gpu-amd kmod — build IN the FreeBSD VM (kld modules are KBI-bound
# to the running kernel; never cross-compile). Via the 9p share:
#   cd /mnt/host/atrium-gpu-amd && make && kldload ./atrium_gpu_amd.ko
#
# Requires the device present: boot the VM with `run-vm.sh --gpusim`.

KMOD=	atrium_gpu_amd
SRCS=	module.c firmware.c gmc.c bo.c cp.c irq.c sync.c ioctl.c
# newbus + pci interface glue generated by the kernel build.
SRCS+=	device_if.h bus_if.h pci_if.h

.include <bsd.kmod.mk>
