#!/bin/sh
#
# atrium-zram — compressed-RAM swap device (atrium_zram.ko -> /dev/zram0),
# the non-destructive reclaim tier of the Atrium memory stack
# (docs/spec/atrium-memory-pressure.md). A kernel module (rank 0, TCB-loaded:
# apps can never kldload, §9.1) that the kernel pages cold anon into — so the
# system compresses before the controller (memoryd) has to kill anything.
#
# DEFERRED past sshd on purpose (the atrium_virtio_gpu lesson): a kmod bug must
# not brick boot before our only diagnostic channel is up. NOT preloaded.
#
# Install: cp to /usr/local/etc/rc.d/atrium-zram ; the .ko to /boot/modules/.
# Enable in /etc/rc.conf:
#   atrium_zram_enable="YES"
# Optional:
#   atrium_zram_swap="YES"                          # swapon after load
#   atrium_zram_module="/boot/modules/atrium_zram.ko"
#   atrium_zram_dev="/dev/zram0"
#   atrium_zram_backing="gpt/swapfs"    # disk partition for cold/incompressible
#                                       # pages (atrium-zram-v2.md §4.5). It is
#                                       # taken off swap and given to zram, so
#                                       # only zram0 is swapped on. zram gets it
#                                       # under GELI one-time (a fresh random key
#                                       # each boot, mail.md §6.4a A3) as
#                                       # <backing>.eli, never plain: if GELI
#                                       # fails, zram runs with no backing store.
#
# Any other swap device still on after start that isn't a .eli or zram0 is
# plain swap: it is reported on every start. List swap in fstab as
# /dev/<part>.eli (swapon(8) makes it one-time).

# PROVIDE: atrium_zram
# REQUIRE: sshd
# KEYWORD: nojail shutdown

. /etc/rc.subr

name="atrium_zram"
desc="Atrium compressed-RAM swap device"
rcvar="${name}_enable"

load_rc_config "$name"

: ${atrium_zram_enable:="NO"}
: ${atrium_zram_swap:="YES"}
: ${atrium_zram_module:="/boot/modules/atrium_zram.ko"}
: ${atrium_zram_dev:="/dev/zram0"}
: ${atrium_zram_backing:=""}

start_cmd="atrium_zram_start"
stop_cmd="atrium_zram_stop"

atrium_zram_start()
{
	if ! kldstat -q -m atrium_zram; then
		if [ ! -f "${atrium_zram_module}" ]; then
			echo "atrium_zram: ${atrium_zram_module} not found, skipping"
			return 0
		fi
		echo "atrium_zram: loading kmod"
		kldload "${atrium_zram_module}" || {
			echo "atrium_zram: kldload failed"
			return 1
		}
	fi
	# The module creates the device at MOD_LOAD (disk_create); it should be
	# present immediately after kldload.
	if [ ! -c "${atrium_zram_dev}" ]; then
		echo "atrium_zram: WARNING ${atrium_zram_dev} not present after load"
		return 1
	fi
	if [ -n "${atrium_zram_backing}" ] && \
	    [ -z "$(sysctl -n kern.zram.backing_dev)" ]; then
		# FreeBSD stripes swap across every device with no priorities, so
		# the partition must not stay a swap device next to zram0.
		backing="${atrium_zram_backing#/dev/}"
		bdev="/dev/${backing}"
		for d in "${bdev}" "${bdev}.eli"; do
			if swapinfo | grep -q "^${d} "; then
				echo "atrium_zram: swapoff ${d} (becomes zram backing)"
				swapoff "${d}" || echo "atrium_zram: swapoff ${d} failed"
			fi
		done
		# swapon(8)'s one-time .eli detaches on its last close; wait
		# (bounded) so the partition is free for a fresh key.
		n=0
		while [ -e "${bdev}.eli" ] && [ $n -lt 10 ]; do
			geli detach "${bdev}.eli" 2>/dev/null || sleep 1
			n=$((n + 1))
		done
		# Pages written back are plaintext: the store is only ever the
		# one-time GELI provider, never the partition itself.
		if kldload -n geom_eli && [ ! -e "${bdev}.eli" ] && \
		    geli onetime -d -e AES-XTS -l 256 -s 4096 "${bdev}" && \
		    [ -c "${bdev}.eli" ]; then
			sysctl kern.zram.backing_dev="${backing}.eli" >/dev/null ||
			    echo "atrium_zram: backing store ${backing}.eli not attached"
		else
			echo "atrium_zram: GELI one-time on ${bdev} failed: no backing store (RAM only)"
		fi
	fi
	if checkyesno atrium_zram_swap; then
		# Idempotent — only swapon if it is not already a swap device.
		if ! swapinfo | grep -q "${atrium_zram_dev}"; then
			# -E: BIO_DELETE the whole device at swapon, so nothing stale
			# survives a re-swapon. (It is NOT online trim: FreeBSD's swap
			# pager does not report freed blocks; atrium-zram-v2.md §4.0.)
			echo "atrium_zram: swapon -E ${atrium_zram_dev}"
			swapon -E "${atrium_zram_dev}" || echo "atrium_zram: swapon failed"
		fi
	fi
	plain=$(swapinfo | awk -v z="${atrium_zram_dev}" 'NR > 1 && $1 != "Total" && $1 != z && $1 !~ /\.eli$/ { print $1 }')
	if [ -n "${plain}" ]; then
		echo "atrium_zram: WARNING plain swap (not GELI one-time): ${plain}"
	fi
	echo "atrium_zram: ${atrium_zram_dev} ready"
}

atrium_zram_stop()
{
	if swapinfo | grep -q "${atrium_zram_dev}"; then
		swapoff "${atrium_zram_dev}" || true
	fi
	if kldstat -q -m atrium_zram; then
		kldunload atrium_zram || true
	fi
}

run_rc_command "$1"
