# Cargo build artifacts — across every Rust crate in the tree.
**/target/
**/Cargo.lock.bak

# Insula release-artifact staging from scripts/build-insula.sh.
/dist/

# Rust analyzer caches.
**/.rustc_info.json

# SPIR-V build artifacts — every SPIR-V bundle (`bundles/*/`) ships
# its `.glsl` / `.comp` / `.vert` / `.frag` sources; the `.spv`
# binaries are generated locally on each dev machine via that
# bundle's `build.sh`. See `bundles/atrium-core/build.sh`.
**/*.spv

# Kernel-module build artifacts (atrium-kmod and any future kmod).
**/*.kld
**/*.ko
**/*.o
**/.depend.*
**/export_syms
**/opt_global.h
**/bus_if.h
**/device_if.h
**/pci_if.h
**/vnode_if.h
**/vnode_if_newproto.h
**/vnode_if_typedef.h
# `machine` symlink the kmod build creates pointing at /usr/src/sys/<arch>/include.
atrium-kmod/machine
fresco-kmod/machine

# In-VM-built test programs.
atrium-kmod/test_caps
atrium-kmod/test_scanout
fresco-kmod/test_roundtrip

# FreeBSD sysroot, kernel src, qcow2 disk image, downloads — too large
# and/or licensing-sensitive to ship in-repo. Contributors recreate
# these from FreeBSD's own distfiles per RUNBOOK.
sysroot/
freebsd-src/
vm/*.qcow2
vm/*.qcow2.xz
vm/*.qcow2.xz.original
vm/*.img
vm/*.fd
vm/kgdb-symbols/
tarballs/

# Test-tool extracted source trees that occasionally land in scratch/.
scratch/pjdfstest_*

# Local IDE / OS junk.
.DS_Store
.vscode/
.idea/
*.swp

# Ad-hoc local logs.
*.log

# Settings local to one machine.
.claude/settings.local.json
atrium-kmod/bootfb/machine

# Rendered presentation artifacts (regenerable from .slides.md via marp).
docs/spec/*.slides.html
docs/spec/*.slides.pdf
docs/spec/*.slides.pptx

# External clones (atrium-related repos vendored as siblings; each is
# its own git working tree with its own remote — see RUNBOOK §11).
external/

# VM debug screenshots — dev-iteration captures accumulate here. Milestone /
# showcase frames that are worth keeping are committed explicitly (git add -f).
vm/*.png
