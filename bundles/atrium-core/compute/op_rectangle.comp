// Compute shader for atrium-core's `rect` op.
//
// Per scene node, write one InstanceRecord into the instance buffer
// and bump the atomic counter. fresco-server's per-frame compute pass
// (step 7) dispatches this with one thread per scene node; the render
// pass (step 8) then reads `count` and `instances` via
// vkCmdDrawIndexedIndirectCount to issue ONE instanced draw covering
// every rect in one call.
//
// Step 3 of the POC: shader compiles to SPIR-V; binding shapes and
// data layout match what the host shim will provide in step 7. The
// scene format here is intentionally flat (no hierarchy) to keep this
// step minimal — hierarchical traversal arrives in a later phase
// alongside the §3.6 multi-level scene buffer.

#version 460

// ── data shapes (mirror Rust-side structs in fresco-vulkan; keep in
//                 lockstep) ──

struct SceneNode {
    /* Per-node parameters for the rect op. 32 bytes; 16-byte aligned. */
    vec2 position;   /* top-left, in screen pixels */
    vec2 size;       /* width / height, in screen pixels */
    vec4 color;      /* rgba */
};

struct InstanceRecord {
    /* What the render pipeline (pipe_rectangle.vert) consumes per
     * instance. 32 bytes. */
    vec4 model;      /* x, y, w, h — same as SceneNode for rect-only POC */
    vec4 color;
};

// ── bindings ──

layout(set = 0, binding = 0) readonly buffer SceneBuf {
    uint       node_count;
    uint       _pad0[3];
    SceneNode  nodes[];
} scene;

layout(set = 0, binding = 1) writeonly buffer InstanceBuf {
    InstanceRecord instances[];
} instance_buf;

layout(set = 0, binding = 2) buffer CounterBuf {
    uint count;
} counter;

// ── kernel ──

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= scene.node_count) {
        return;
    }
    SceneNode n = scene.nodes[id];

    /* Reserve a slot in the instance buffer atomically; this lets us
     * cull (skip) nodes via early `return` above without producing
     * holes in the output. For step 3 with no culling, atomicAdd is
     * still the right shape because hierarchy traversal in the future
     * may issue 0..N instances per node depending on visibility. */
    uint slot = atomicAdd(counter.count, 1);

    instance_buf.instances[slot].model = vec4(n.position, n.size);
    instance_buf.instances[slot].color = n.color;
}
