#version 450
#extension GL_GOOGLE_include_directive : require
// raster: one invocation per pixel. Walks the ops binned to the pixel's tile
// in draw order, evaluates each op's coverage and colour the way the Fresco
// fragment shaders do, blends src-over in linear RGB, then writes the pixel
// sRGB-encoded as BGRA8 (alpha 255) straight into the scanout buffer.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Per texture: first word in `texels`, width, height, format (0 RGBA8 sRGB,
// 1 R8 unorm, four texels per word).
layout(std430, set = 0, binding = 2) readonly buffer TexB { uint texw[]; };
layout(std430, set = 0, binding = 3) readonly buffer TexelB { uint texels[]; };
layout(std430, set = 0, binding = 4) readonly buffer MaskB { uint mask[]; };
layout(std430, set = 0, binding = 5) writeonly buffer TargetB { uint target[]; };
// srgb_to_linear[256], then encode thresholds: byte b+1 starts at lut[ENC + b].
layout(std430, set = 0, binding = 6) readonly buffer LutB { float lut[]; };
#define ENC 256u

vec4 texel(uvec4 t, int x, int y) {
    x = clamp(x, 0, int(t.y) - 1);
    y = clamp(y, 0, int(t.z) - 1);
    uint idx = uint(y) * t.y + uint(x);
    uint wi = t.x + (t.w == 0u ? idx : idx / 4u);
    if (wi >= F.texel_words) {
        return vec4(0.0);
    }
    if (t.w == 0u) {
        uint w = texels[wi];
        return vec4(lut[w & 255u], lut[(w >> 8) & 255u], lut[(w >> 16) & 255u],
                    float(w >> 24) * (1.0 / 255.0)); // glslang folds "/ 255.0" to this anyway
    }
    uint w = texels[wi];
    float v = float((w >> (8u * (idx % 4u))) & 255u) * (1.0 / 255.0);
    return vec4(v, 0.0, 0.0, 1.0);
}

// GLSL leaves mix's formula to the implementation; this is the one every
// executor and src/reference.rs use.
vec4 mix_(vec4 a, vec4 b, float t) { return a + t * (b - a); }

// Bilinear, clamp to edge, uv in [0, 1].
vec4 sample_bilinear(uint ti, vec2 uv) {
    if (ti >= F.tex_count) {
        return vec4(0.0);
    }
    uvec4 t = uvec4(texw[ti * 4u], texw[ti * 4u + 1u], texw[ti * 4u + 2u], texw[ti * 4u + 3u]);
    // An empty or over-wide texture samples as zero.
    if (t.y == 0u || t.z == 0u || t.y > MAX_TEX_DIM || t.z > MAX_TEX_DIM) {
        return vec4(0.0);
    }
    vec2 tc = uv * vec2(float(t.y), float(t.z)) - 0.5;
    vec2 fl = floor(tc);
    vec2 f = tc - fl;
    int x = int(clamp_(fl.x, -1.0, float(t.y)));
    int y = int(clamp_(fl.y, -1.0, float(t.z)));
    vec4 a = mix_(texel(t, x, y), texel(t, x + 1, y), f.x);
    vec4 b = mix_(texel(t, x, y + 1), texel(t, x + 1, y + 1), f.x);
    return mix_(a, b, f.y);
}

bool inside(vec4 r, vec2 pc) {
    return pc.x >= r.x && pc.x < r.x + r.z && pc.y >= r.y && pc.y < r.y + r.w;
}

// Filled paths (src/fill.rs has the normative rule and block layout).
#define FILL_HEADER 18u
#define FILL_MAX_STOPS 16u
#define FILL_STOP 5u
#define FILL_ENTRY 18u
#define FILL_MAX_GRID 1024u
#define FILL_MAX_TILE_SEGS 4096u

float fill_g(float t) {
    if (t <= 0.0) {
        return t;
    }
    if (t >= 1.0) {
        return 0.5;
    }
    return t - 0.5 * t * t;
}

// One line's signed area in pixel (px, py): fill::fill_line.
float fill_line(vec4 s, float px, float py) {
    if (s.w == s.y) {
        return 0.0;
    }
    float sy0 = s.y < s.w ? s.y : s.w;
    float sy1 = s.y < s.w ? s.w : s.y;
    float ylo = py;
    float yhi = py + 1.0;
    if (!(sy1 > ylo && sy0 < yhi)) {
        return 0.0;
    }
    float dxdy = (s.z - s.x) / (s.w - s.y);
    float ya = sy0 > ylo ? sy0 : ylo;
    float yb = sy1 < yhi ? sy1 : yhi;
    float ta = (s.x + (ya - s.y) * dxdy) - px;
    float tb = (s.x + (yb - s.y) * dxdy) - px;
    float dy = yb - ya;
    float a;
    if (abs(tb - ta) < 1e-5) {
        a = clamp_(1.0 - 0.5 * (ta + tb), 0.0, 1.0);
    } else {
        a = (fill_g(tb) - fill_g(ta)) / (tb - ta);
    }
    a = dy * a;
    return s.w > s.y ? a : -a;
}

vec4 fill_shade(vec4 c, vec4 color, uint b, vec2 pc) {
    if (!(pc.x >= c.x && pc.x < c.z && pc.y >= c.y && pc.y < c.w)) {
        return vec4(0.0);
    }
    uint tw_ = F.texel_words;
    if (b >= tw_ || tw_ - b < FILL_HEADER) {
        return vec4(0.0);
    }
    uint tx0 = texels[b];
    uint ty0 = texels[b + 1u];
    uint gw = texels[b + 2u];
    uint gh = texels[b + 3u];
    uint sbase = texels[b + 4u];
    uint scount = texels[b + 5u];
    uint rule = texels[b + 6u];
    float px = pc.x - 0.5;
    float py = pc.y - 0.5;
    uint x = uint(px);
    uint y = uint(py);
    uint tx = x / TILE - tx0;
    uint ty = y / TILE - ty0;
    if (gw > FILL_MAX_GRID || gh > FILL_MAX_GRID || tx >= gw || ty >= gh || sbase > tw_ || scount > (tw_ - sbase) / 4u) {
        return vec4(0.0);
    }
    uint idx = ty * gw + tx;
    if (idx >= (tw_ - b - FILL_HEADER) / FILL_ENTRY) {
        return vec4(0.0);
    }
    uint e = b + FILL_HEADER + idx * FILL_ENTRY;
    uint ls = texels[e];
    uint lc = texels[e + 1u];
    if (lc > FILL_MAX_TILE_SEGS) {
        lc = FILL_MAX_TILE_SEGS;
    }
    float acc = uintBitsToFloat(texels[e + 2u + y % TILE]);
    if (ls > tw_ || lc > tw_ - ls) {
        lc = 0u;
    }
    for (uint k = 0u; k < lc; k++) {
        uint si = texels[ls + k];
        if (si >= scount) {
            continue;
        }
        uint w = sbase + si * 4u;
        vec4 s = vec4(uintBitsToFloat(texels[w]), uintBitsToFloat(texels[w + 1u]),
                      uintBitsToFloat(texels[w + 2u]), uintBitsToFloat(texels[w + 3u]));
        acc = acc + fill_line(s, px, py);
    }
    float a = abs(acc);
    if (rule == 1u) {
        a = a - 2.0 * floor(a * 0.5);
        if (a > 1.0) {
            a = 2.0 - a;
        }
    }
    float cov = clamp_(a, 0.0, 1.0);
    uint paint = texels[b + 8u];
    if (paint == 0u) {
        return vec4(color.rgb, color.a * cov);
    }
    uint sat = texels[b + 9u];
    uint n = texels[b + 10u];
    if (n == 0u || n > FILL_MAX_STOPS || sat > tw_ || n * FILL_STOP > tw_ - sat) {
        return vec4(0.0);
    }
    float u = uintBitsToFloat(texels[b + 11u]) * pc.x + uintBitsToFloat(texels[b + 12u]) * pc.y + uintBitsToFloat(texels[b + 13u]);
    float gt = u;
    if (paint != 1u) {
        float v = uintBitsToFloat(texels[b + 14u]) * pc.x + uintBitsToFloat(texels[b + 15u]) * pc.y + uintBitsToFloat(texels[b + 16u]);
        gt = sqrt(u * u + v * v);
    }
    // gradient_at: pad, find the span, interpolate premultiplied sRGB.
    float first = uintBitsToFloat(texels[sat]);
    float last = uintBitsToFloat(texels[sat + (n - 1u) * FILL_STOP]);
    gt = gt >= first ? (gt <= last ? gt : last) : first;
    uint i = 0u;
    while (i + 1u < n && uintBitsToFloat(texels[sat + (i + 1u) * FILL_STOP]) < gt) {
        i = i + 1u;
    }
    uint j = i + 1u < n ? i + 1u : i;
    uint w0 = sat + i * FILL_STOP;
    uint w1 = sat + j * FILL_STOP;
    float o0 = uintBitsToFloat(texels[w0]);
    float o1 = uintBitsToFloat(texels[w1]);
    vec4 c0 = vec4(uintBitsToFloat(texels[w0 + 1u]), uintBitsToFloat(texels[w0 + 2u]), uintBitsToFloat(texels[w0 + 3u]), uintBitsToFloat(texels[w0 + 4u]));
    vec4 c1 = vec4(uintBitsToFloat(texels[w1 + 1u]), uintBitsToFloat(texels[w1 + 2u]), uintBitsToFloat(texels[w1 + 3u]), uintBitsToFloat(texels[w1 + 4u]));
    float span = o1 - o0;
    float f = span > 0.0 ? (gt - o0) / span : 1.0;
    vec3 pa = vec3(c0.x * c0.w, c0.y * c0.w, c0.z * c0.w);
    vec3 pb = vec3(c1.x * c1.w, c1.y * c1.w, c1.z * c1.w);
    float ga = c0.w + f * (c1.w - c0.w);
    vec3 p = vec3(pa.x + f * (pb.x - pa.x), pa.y + f * (pb.y - pa.y), pa.z + f * (pb.z - pa.z));
    vec3 sc = ga > 0.0 ? vec3(p.x / ga, p.y / ga, p.z / ga) : vec3(0.0);
    vec3 lin = vec3(lut[uint(clamp_(sc.x, 0.0, 1.0) * 255.0 + 0.5)],
                    lut[uint(clamp_(sc.y, 0.0, 1.0) * 255.0 + 0.5)],
                    lut[uint(clamp_(sc.z, 0.0, 1.0) * 255.0 + 0.5)]);
    return vec4(lin, ga * color.a * cov);
}

vec4 shade(uint oi, vec2 pc) {
    uint base = oi * OP_VEC4S;
    vec4 p0 = opv[base];
    vec4 p1 = opv[base + 1u];
    vec4 p2 = opv[base + 2u];
    vec4 p3 = opv[base + 3u];
    uvec4 meta = floatBitsToUint(opv[base + 4u]);
    // The op's whole-pixel box is also its clip (ordered compares: a NaN
    // box draws nothing).
    if (!(pc.x >= p3.x && pc.x < p3.z && pc.y >= p3.y && pc.y < p3.w)) {
        return vec4(0.0);
    }
    uint kind = meta.x;
    if (kind == KIND_FILL) {
        return fill_shade(p0, p1, meta.y, pc);
    }
    if (kind == KIND_PATH) {
        vec2 v = pc - p0.xy;
        float lx = p2.x * v.x + p2.y * v.y;
        float ly = p2.x * v.y - p2.y * v.x;
        float hl = p0.z * 0.5;
        float hw = p0.w * 0.5;
        if (lx >= -hl && lx < hl && ly >= -hw && ly < hw) {
            return p1;
        }
        return vec4(0.0);
    }
    if (!inside(p0, pc)) {
        return vec4(0.0);
    }
    if (kind == KIND_RECT) {
        float radius = p2.x;
        if (radius <= 0.0) {
            return p1;
        }
        vec2 half_ext = p0.zw * 0.5;
        float r = min_(radius, min_(half_ext.x, half_ext.y));
        vec2 p = (pc - p0.xy) - half_ext;
        vec2 q = abs(p) - half_ext + r;
        vec2 qp = vec2(max_(q.x, 0.0), max_(q.y, 0.0));
        float lq = length(qp);
        float d = min_(max_(q.x, q.y), 0.0) + lq - r;
        // fwidth(d): the SDF's gradient is a unit vector, so |dx| + |dy| is
        // 1 along the straight edges and |nx| + |ny| around a corner.
        float aa = 1.0;
        if (q.x > 0.0 && q.y > 0.0) {
            aa = (q.x + q.y) / lq;
        }
        float alpha = clamp_(0.5 - d / aa, 0.0, 1.0);
        return vec4(p1.rgb, p1.a * alpha);
    }
    vec2 t = (pc - p0.xy) / p0.zw;
    if (kind == KIND_TEXTURE) {
        return sample_bilinear(meta.y, t);
    }
    // KIND_GLYPH
    vec2 uv = p2.xy + t * (p2.zw - p2.xy); // mix_, per component
    float cov = sample_bilinear(meta.y, uv).r;
    return vec4(p1.rgb, p1.a * cov);
}

// The open layers, newest first: what was under each (s<k>) and its
// opacity (o<k>). ISOLATE_DEPTH (lib.rs) is 4. Scalars (no arrays, no
// vector selects), so every executor keeps them in registers; a push
// shifts them down one, a pop shifts them back up.
#define SAVE_LAYER(k, j) { s##k##r = s##j##r; s##k##g = s##j##g; s##k##b = s##j##b; s##k##a = s##j##a; o##k = o##j; }

// Blend the newest layer, at its opacity, over what was under it.
#define POP_LAYER { \
    float ga = da * o0; \
    dr = dr * o0 + s0r * (1.0 - ga); \
    dg = dg * o0 + s0g * (1.0 - ga); \
    db = db * o0 + s0b * (1.0 - ga); \
    da = ga + s0a * (1.0 - ga); \
    SAVE_LAYER(0, 1) \
    SAVE_LAYER(1, 2) \
    SAVE_LAYER(2, 3) \
    sp = sp - 1u; \
}

uint encode(float v) {
    uint lo = 0u;
    for (uint step = 128u; step > 0u; step = step / 2u) {
        if (lo + step <= 255u && v >= lut[ENC + lo + step - 1u]) {
            lo = lo + step;
        }
    }
    return lo;
}

void main() {
    uvec3 gid = gl_GlobalInvocationID; // whole-vector load: GIR takes no access chain into a builtin
    uint x = gid.x;
    uint y = gid.y;
    if (x >= F.width || y >= F.height) {
        return;
    }
    vec2 pc = vec2(float(x), float(y)) + 0.5;
    uint tile = (y / TILE) * F.tiles_x + (x / TILE);
    // Premultiplied linear RGB and alpha: a surface's clear may be
    // transparent (compose blends it), the screen's is opaque.
    // Premultiplied colour and alpha, and the open layers (see SAVE_LAYER).
    float dr = F.clear.r;
    float dg = F.clear.g;
    float db = F.clear.b;
    float da = F.clear.a;
    float s0r = 0.0; float s0g = 0.0; float s0b = 0.0; float s0a = 0.0; float o0 = 0.0;
    float s1r = 0.0; float s1g = 0.0; float s1b = 0.0; float s1a = 0.0; float o1 = 0.0;
    float s2r = 0.0; float s2g = 0.0; float s2b = 0.0; float s2a = 0.0; float o2 = 0.0;
    float s3r = 0.0; float s3g = 0.0; float s3b = 0.0; float s3a = 0.0; float o3 = 0.0;
    uint sp = 0u;
    uint over = 0u;
    for (uint w = 0u; w < F.wpt; w++) {
        uint bits = mask[tile * F.wpt + w];
        while (bits != 0u) {
            int i = findLSB(bits);
            bits = bits & (bits - 1u);
            uint oi = w * 32u + uint(i);
            if (oi >= F.op_count) {
                break;
            }
            // Whole-vector loads: the Tier-2 frontend takes no constant
            // index after a dynamic one.
            uvec4 meta = floatBitsToUint(opv[oi * OP_VEC4S + 4u]);
            vec4 p1 = opv[oi * OP_VEC4S + 1u];
            uint kind = meta.x;
            if (kind == KIND_PUSH) {
                if (sp >= ISOLATE_DEPTH) {
                    over = over + 1u;
                } else {
                    SAVE_LAYER(3, 2)
                    SAVE_LAYER(2, 1)
                    SAVE_LAYER(1, 0)
                    s0r = dr; s0g = dg; s0b = db; s0a = da;
                    o0 = clamp_(p1.x, 0.0, 1.0);
                    sp = sp + 1u;
                    dr = 0.0;
                    dg = 0.0;
                    db = 0.0;
                    da = 0.0;
                }
            } else if (kind == KIND_POP) {
                if (over > 0u) {
                    over = over - 1u;
                } else if (sp > 0u) {
                    POP_LAYER
                }
            } else {
                vec4 src = shade(oi, pc);
                dr = src.r * src.a + dr * (1.0 - src.a);
                dg = src.g * src.a + dg * (1.0 - src.a);
                db = src.b * src.a + db * (1.0 - src.a);
                da = src.a + da * (1.0 - src.a);
            }
        }
    }
    for (uint k = 0u; k < ISOLATE_DEPTH; k++) {
        if (sp > 0u) {
            POP_LAYER
        }
    }
    uint r = encode(dr);
    uint g = encode(dg);
    uint b = encode(db);
    uint a = uint(clamp_(da, 0.0, 1.0) * 255.0 + 0.5);
    target[y * F.pitch + x] = b | (g << 8) | (r << 16) | (a << 24);
}
