#version 450
#extension GL_GOOGLE_include_directive : require
// raster: one invocation per pixel. Walks the ops binned to the pixel's tile
// in draw order, evaluates each op's coverage and colour the way the Fresco
// fragment shaders do, blends src-over in linear RGB, then writes the pixel
// sRGB-encoded as BGRA8 (alpha 255) straight into the scanout buffer.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Per texture: first word in `texels`, width, height, format (0 RGBA8 sRGB,
// 1 R8 unorm, four texels per word).
layout(std430, set = 0, binding = 2) readonly buffer TexB { uint texw[]; };
layout(std430, set = 0, binding = 3) readonly buffer TexelB { uint texels[]; };
layout(std430, set = 0, binding = 4) readonly buffer MaskB { uint mask[]; };
layout(std430, set = 0, binding = 5) writeonly buffer TargetB { uint target[]; };
// srgb_to_linear[256], then encode thresholds: byte b+1 starts at lut[ENC + b].
layout(std430, set = 0, binding = 6) readonly buffer LutB { float lut[]; };
#define ENC 256u

vec4 texel(uvec4 t, int x, int y) {
    x = clamp(x, 0, int(t.y) - 1);
    y = clamp(y, 0, int(t.z) - 1);
    uint idx = uint(y) * t.y + uint(x);
    uint wi = t.x + (t.w == 0u ? idx : idx / 4u);
    if (wi >= F.texel_words) {
        return vec4(0.0);
    }
    if (t.w == 0u) {
        uint w = texels[wi];
        return vec4(lut[w & 255u], lut[(w >> 8) & 255u], lut[(w >> 16) & 255u],
                    float(w >> 24) * (1.0 / 255.0)); // glslang folds "/ 255.0" to this anyway
    }
    uint w = texels[wi];
    float v = float((w >> (8u * (idx % 4u))) & 255u) * (1.0 / 255.0);
    return vec4(v, 0.0, 0.0, 1.0);
}

// GLSL leaves mix's formula to the implementation; this is the one every
// executor and src/reference.rs use.
vec4 mix_(vec4 a, vec4 b, float t) { return a + t * (b - a); }

// Bilinear, clamp to edge, uv in [0, 1].
vec4 sample_bilinear(uint ti, vec2 uv) {
    if (ti >= F.tex_count) {
        return vec4(0.0);
    }
    uvec4 t = uvec4(texw[ti * 4u], texw[ti * 4u + 1u], texw[ti * 4u + 2u], texw[ti * 4u + 3u]);
    // An empty or over-wide texture samples as zero.
    if (t.y == 0u || t.z == 0u || t.y > MAX_TEX_DIM || t.z > MAX_TEX_DIM) {
        return vec4(0.0);
    }
    vec2 tc = uv * vec2(float(t.y), float(t.z)) - 0.5;
    vec2 fl = floor(tc);
    vec2 f = tc - fl;
    int x = int(clamp_(fl.x, -1.0, float(t.y)));
    int y = int(clamp_(fl.y, -1.0, float(t.z)));
    vec4 a = mix_(texel(t, x, y), texel(t, x + 1, y), f.x);
    vec4 b = mix_(texel(t, x, y + 1), texel(t, x + 1, y + 1), f.x);
    return mix_(a, b, f.y);
}

bool inside(vec4 r, vec2 pc) {
    return pc.x >= r.x && pc.x < r.x + r.z && pc.y >= r.y && pc.y < r.y + r.w;
}

// Filled paths (src/fill.rs has the normative rule and block layout).
#define FILL_HEADER 8u
#define FILL_ENTRY 18u
#define FILL_MAX_GRID 1024u
#define FILL_MAX_TILE_SEGS 4096u

float fill_g(float t) {
    if (t <= 0.0) {
        return t;
    }
    if (t >= 1.0) {
        return 0.5;
    }
    return t - 0.5 * t * t;
}

// One line's signed area in pixel (px, py): fill::fill_line.
float fill_line(vec4 s, float px, float py) {
    if (s.w == s.y) {
        return 0.0;
    }
    float sy0 = s.y < s.w ? s.y : s.w;
    float sy1 = s.y < s.w ? s.w : s.y;
    float ylo = py;
    float yhi = py + 1.0;
    if (!(sy1 > ylo && sy0 < yhi)) {
        return 0.0;
    }
    float dxdy = (s.z - s.x) / (s.w - s.y);
    float ya = sy0 > ylo ? sy0 : ylo;
    float yb = sy1 < yhi ? sy1 : yhi;
    float ta = (s.x + (ya - s.y) * dxdy) - px;
    float tb = (s.x + (yb - s.y) * dxdy) - px;
    float dy = yb - ya;
    float a;
    if (abs(tb - ta) < 1e-5) {
        a = clamp_(1.0 - 0.5 * (ta + tb), 0.0, 1.0);
    } else {
        a = (fill_g(tb) - fill_g(ta)) / (tb - ta);
    }
    a = dy * a;
    return s.w > s.y ? a : -a;
}

vec4 fill_shade(vec4 c, vec4 color, uint b, vec2 pc) {
    if (!(pc.x >= c.x && pc.x < c.z && pc.y >= c.y && pc.y < c.w)) {
        return vec4(0.0);
    }
    uint tw_ = F.texel_words;
    if (b >= tw_ || tw_ - b < FILL_HEADER) {
        return vec4(0.0);
    }
    uint tx0 = texels[b];
    uint ty0 = texels[b + 1u];
    uint gw = texels[b + 2u];
    uint gh = texels[b + 3u];
    uint sbase = texels[b + 4u];
    uint scount = texels[b + 5u];
    uint rule = texels[b + 6u];
    float px = pc.x - 0.5;
    float py = pc.y - 0.5;
    uint x = uint(px);
    uint y = uint(py);
    uint tx = x / TILE - tx0;
    uint ty = y / TILE - ty0;
    if (gw > FILL_MAX_GRID || gh > FILL_MAX_GRID || tx >= gw || ty >= gh || sbase > tw_ || scount > (tw_ - sbase) / 4u) {
        return vec4(0.0);
    }
    uint idx = ty * gw + tx;
    if (idx >= (tw_ - b - FILL_HEADER) / FILL_ENTRY) {
        return vec4(0.0);
    }
    uint e = b + FILL_HEADER + idx * FILL_ENTRY;
    uint ls = texels[e];
    uint lc = texels[e + 1u];
    if (lc > FILL_MAX_TILE_SEGS) {
        lc = FILL_MAX_TILE_SEGS;
    }
    float acc = uintBitsToFloat(texels[e + 2u + y % TILE]);
    if (ls > tw_ || lc > tw_ - ls) {
        lc = 0u;
    }
    for (uint k = 0u; k < lc; k++) {
        uint si = texels[ls + k];
        if (si >= scount) {
            continue;
        }
        uint w = sbase + si * 4u;
        vec4 s = vec4(uintBitsToFloat(texels[w]), uintBitsToFloat(texels[w + 1u]),
                      uintBitsToFloat(texels[w + 2u]), uintBitsToFloat(texels[w + 3u]));
        acc = acc + fill_line(s, px, py);
    }
    float a = abs(acc);
    if (rule == 1u) {
        a = a - 2.0 * floor(a * 0.5);
        if (a > 1.0) {
            a = 2.0 - a;
        }
    }
    float cov = clamp_(a, 0.0, 1.0);
    return vec4(color.rgb, color.a * cov);
}

vec4 shade(uint oi, vec2 pc) {
    uint base = oi * OP_VEC4S;
    vec4 p0 = opv[base];
    vec4 p1 = opv[base + 1u];
    vec4 p2 = opv[base + 2u];
    uvec4 meta = floatBitsToUint(opv[base + 4u]);
    uint kind = meta.x;
    if (kind == KIND_FILL) {
        return fill_shade(p0, p1, meta.y, pc);
    }
    if (kind == KIND_PATH) {
        vec2 v = pc - p0.xy;
        float lx = p2.x * v.x + p2.y * v.y;
        float ly = p2.x * v.y - p2.y * v.x;
        float hl = p0.z * 0.5;
        float hw = p0.w * 0.5;
        if (lx >= -hl && lx < hl && ly >= -hw && ly < hw) {
            return p1;
        }
        return vec4(0.0);
    }
    if (!inside(p0, pc)) {
        return vec4(0.0);
    }
    if (kind == KIND_RECT) {
        float radius = p2.x;
        if (radius <= 0.0) {
            return p1;
        }
        vec2 half_ext = p0.zw * 0.5;
        float r = min_(radius, min_(half_ext.x, half_ext.y));
        vec2 p = (pc - p0.xy) - half_ext;
        vec2 q = abs(p) - half_ext + r;
        vec2 qp = vec2(max_(q.x, 0.0), max_(q.y, 0.0));
        float lq = length(qp);
        float d = min_(max_(q.x, q.y), 0.0) + lq - r;
        // fwidth(d): the SDF's gradient is a unit vector, so |dx| + |dy| is
        // 1 along the straight edges and |nx| + |ny| around a corner.
        float aa = 1.0;
        if (q.x > 0.0 && q.y > 0.0) {
            aa = (q.x + q.y) / lq;
        }
        float alpha = clamp_(0.5 - d / aa, 0.0, 1.0);
        return vec4(p1.rgb, p1.a * alpha);
    }
    vec2 t = (pc - p0.xy) / p0.zw;
    if (kind == KIND_TEXTURE) {
        return sample_bilinear(meta.y, t);
    }
    // KIND_GLYPH
    vec2 uv = p2.xy + t * (p2.zw - p2.xy); // mix_, per component
    float cov = sample_bilinear(meta.y, uv).r;
    return vec4(p1.rgb, p1.a * cov);
}

uint encode(float v) {
    uint lo = 0u;
    for (uint step = 128u; step > 0u; step = step / 2u) {
        if (lo + step <= 255u && v >= lut[ENC + lo + step - 1u]) {
            lo = lo + step;
        }
    }
    return lo;
}

void main() {
    uvec3 gid = gl_GlobalInvocationID; // whole-vector load: GIR takes no access chain into a builtin
    uint x = gid.x;
    uint y = gid.y;
    if (x >= F.width || y >= F.height) {
        return;
    }
    vec2 pc = vec2(float(x), float(y)) + 0.5;
    uint tile = (y / TILE) * F.tiles_x + (x / TILE);
    // Premultiplied linear RGB and alpha: a surface's clear may be
    // transparent (compose blends it), the screen's is opaque.
    vec3 dst = F.clear.rgb;
    float da = F.clear.a;
    for (uint w = 0u; w < F.wpt; w++) {
        uint bits = mask[tile * F.wpt + w];
        while (bits != 0u) {
            int i = findLSB(bits);
            bits = bits & (bits - 1u);
            uint oi = w * 32u + uint(i);
            if (oi >= F.op_count) {
                break;
            }
            vec4 src = shade(oi, pc);
            dst = src.rgb * src.a + dst * (1.0 - src.a);
            da = src.a + da * (1.0 - src.a);
        }
    }
    uint r = encode(dst.r);
    uint g = encode(dst.g);
    uint b = encode(dst.b);
    uint a = uint(clamp_(da, 0.0, 1.0) * 255.0 + 0.5);
    target[y * F.pitch + x] = b | (g << 8) | (r << 16) | (a << 24);
}
