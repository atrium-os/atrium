+// The embedded painter reads a published recording synchronously on the document thread.
+pub use render_state::DocumentHost as EmbeddedDocumentHost;
+
+pub fn with_embedded_recording<T>(
+    host: &EmbeddedDocumentHost,
+    visit: impl FnOnce(
+        &libcompositing_rust::display_list::storage::DisplayListStorage,
+        &libcompositing_rust::scrolling::ScrollStateSnapshot,
+        &std::collections::HashMap<u64, libgfx_rust::font::FontHandle>,
+    ) -> T,
+) -> Option<T> {
+    let output = host.recording().published_recording()?;
+    let tree = output.visual_context_tree.clone()?;
+    let list = libcompositing_rust::display_list::storage::DisplayListStorage::recorded(output.display_list.clone(), tree);
+    Some(visit(&list, &host.scroll_state(), &output.resources.fonts))
+}
 
