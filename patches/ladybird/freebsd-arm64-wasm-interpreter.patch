@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+//! FreeBSD arm64 uses the statically assembled interpreter for every function.
+
+use super::{FunctionAddress, FunctionInstance, InstanceAddress, Store};
+use crate::abi::ExecutionContext;
+
+pub fn initial_tier_up_budget() -> u32 {
+    u32::MAX
+}
+pub fn initial_native_entry() -> u64 {
+    0
+}
+pub fn instantiated(_: &mut Store, _: InstanceAddress) {}
+pub fn large_images_in_use() -> usize {
+    0
+}
+pub fn release_large_images(_: usize) {}
+
+impl Store {
+    pub fn disable_jit(&mut self) {}
+}
+
+pub unsafe fn redirect_fault(_: *mut libc::c_void) -> bool {
+    false
+}
+
+export_runtime_functions! {
+    wasm_runtime_tier_up => reset_budget,
+    wasm_runtime_call_compiled => invalid_native_entry,
+}
+
+unsafe fn reset_budget(context: *mut ExecutionContext) -> u64 {
+    unsafe {
+        let header = (*context).arguments[0] as *const FunctionInstance;
+        FunctionAddress::from_ptr(header).get_mut().header.tier_up_budget = u32::MAX;
+    }
+    0
+}
+
+unsafe fn invalid_native_entry(_: *mut ExecutionContext) -> u64 {
+    std::process::abort()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::runtime::{ExternValue, Trap, Value};
+
+    #[test]
+    fn interprets_after_a_guarded_memory_trap() {
+        let module = crate::compile(include_bytes!("../../tests/fixtures/basics.wasm")).unwrap();
+        let mut store = Store::new();
+        let instance = store.instantiate(std::sync::Arc::new(module), &[]).unwrap();
+        let Some(ExternValue::Function(load)) = store.instance(instance).export("out_of_bounds") else {
+            panic!("missing load fixture");
+        };
+        assert_eq!(store.invoke(load, &[]), Err(Trap::MemoryOutOfBounds));
+        let Some(ExternValue::Function(add)) = store.instance(instance).export("add") else {
+            panic!("missing add fixture");
+        };
+        assert_eq!(
+            store.invoke(add, &[Value::I32(40), Value::I32(2)]),
+            Ok(vec![Value::I32(42)])
+        );
+    }
+}
