+    ByteBuffer out;
+    auto const& request = *item.request;
+    put_bytes(out, request.url().serialize().bytes());
+    put_bytes(out, request.method().bytes());
+    put_headers(out, request.header_list());
+    auto const& response = *item.response;
+    out.append(static_cast<u8>(response.type()));
+    put_u32(out, static_cast<u32>(response.status()));
+    put_bytes(out, response.status_message().bytes());
+    put_u32(out, static_cast<u32>(response.url_list().size()));
+    for (auto const& url : response.url_list())
