+// limen::web_island::idb::tag.
+namespace Tag {
+constexpr u8 Database = 1;
+constexpr u8 Version = 2;
+constexpr u8 DeleteDatabase = 3;
+constexpr u8 Store = 4;
+constexpr u8 CreateStore = 5;
+constexpr u8 Put = 9;
+constexpr u8 Append = 10;
+constexpr u8 Delete = 11;
+}
+
+// The caches navigatord keeps, by their list, with their names (UTF-8).
+HashMap<RequestResponseList const*, ByteString>& names();
+// Each kept item's key, its place in its cache.
+HashMap<RequestResponse const*, u64>& keys();
+u64& next_key();
+
+void begin();
+void send(u8 tag, ReadonlyBytes a, ReadonlyBytes b, u64 n);
+bool commit();
+
+ByteBuffer key_bytes(u64);
+Optional<ByteBuffer> encode_item(RequestResponse const&);
+GC::Ptr<RequestResponse> decode_item(JS::Realm&, ReadonlyBytes);
+
