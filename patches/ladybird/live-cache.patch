+        return {};
+    auto url = URL::Parser::basic_parse(StringView { *url_bytes });
+    auto request_headers = r.headers();
+    if (!url.has_value() || !request_headers.has_value())
+        return {};
+    auto request = Request::create();
+    request->set_url(*url);
+    request->set_method(ByteString(*method));
+    request->set_header_list(*request_headers);
+
+    auto type = r.byte();
+    auto status = r.u32_();
+    auto status_message = r.bytes();
+    auto url_count = r.u32_();
+    if (!type.has_value() || *type > static_cast<u8>(Response::Type::OpaqueRedirect) || !status.has_value() || *status > 999
+        || !status_message.has_value() || !url_count.has_value() || *url_count > r.rest.size() / 4)
+        return {};
+    Vector<URL::URL> url_list;
+    for (u32 i = 0; i < *url_count; ++i) {
+        auto bytes = r.bytes();
+        if (!bytes.has_value())
+            return {};
+        auto parsed = URL::Parser::basic_parse(StringView { *bytes });
+        if (!parsed.has_value())
+            return {};
+        url_list.append(parsed.release_value());
+    }
+    auto response_headers = r.headers();
+    auto has_body = r.byte();
+    if (!response_headers.has_value() || !has_body.has_value() || *has_body > 1)
+        return {};
+    auto internal = Response::create();
+    internal->set_status(static_cast<Status>(*status));
+    internal->set_status_message(ByteString(*status_message));
+    internal->set_url_list(move(url_list));
+    internal->set_header_list(*response_headers);
+    if (*has_body == 1) {
+        auto body = r.bytes();
+        if (!body.has_value())
+            return {};
+        internal->set_body(byte_sequence_as_response_body(*body));
+    }
+    if (!r.rest.is_empty())
+        return {};
+    NonnullRefPtr<Response> record = internal;
+    switch (static_cast<Response::Type>(*type)) {
+    case Response::Type::Basic:
+        record = BasicFilteredResponse::create(internal);
+        break;
+    case Response::Type::CORS:
+        record = CORSFilteredResponse::create(internal);
+        break;
+    case Response::Type::Opaque:
+        record = OpaqueFilteredResponse::create(internal);
+        break;
+    case Response::Type::OpaqueRedirect:
+        record = OpaqueRedirectFilteredResponse::create(internal);
+        break;
+    case Response::Type::Default:
+        break;
+    case Response::Type::Error:
+        return {};
+    }
+    auto view = ResponseView::create(realm, record);
+    return GC::Heap::the().allocate<RequestResponse>(request, view);
+}
