+// Atrium's live pages (I6.7, second part): the first CacheStorage asked for its map loads the page's caches from
+// navigatord and is the one whose caches are kept; any other (a frame's engine gets no store) is the run's.
+static CacheStorage const* s_live_owner = nullptr;
+static bool s_tried = false;
+static bool s_loading = false;
+
+struct LoadedOp {
+    u8 tag;
+    ByteBuffer a;
+    ByteBuffer b;
+    u64 n;
+};
+
+static void on_cache_op(void* ctx, u8 tag, u8 const* a, size_t a_len, u8 const* b, size_t b_len, u64 n)
+{
+    auto& ops = *static_cast<Vector<LoadedOp>*>(ctx);
+    ops.append({ tag, MUST(ByteBuffer::copy(ReadonlyBytes { a, a_len })), MUST(ByteBuffer::copy(ReadonlyBytes { b, b_len })), n });
+}
+
+static void load_if_first(CacheStorage& self, JS::Realm& realm)
+{
+    if (s_tried)
+        return;
+    s_tried = true;
+    Vector<LoadedOp> ops;
+    if (!navigator_live_cache_load(&ops, on_cache_op))
+        return; // navigatord keeps no caches for this engine: they are the run's.
+
+    struct Item {
+        u64 key;
+        ByteBuffer value;
+    };
+    Vector<ByteString> order;
+    HashMap<ByteString, Vector<Item>> items;
+    Optional<ByteString> current;
+    bool bad = false;
+    for (auto& op : ops) {
+        switch (op.tag) {
+        case LiveCache::Tag::Version:
+        case LiveCache::Tag::Database:
+            current = ByteString(op.a.bytes());
+            if (!items.contains(*current)) {
+                order.append(*current);
+                items.set(*current, {});
+            }
+            break;
+        case LiveCache::Tag::CreateStore:
+        case LiveCache::Tag::Store:
+            break;
+        case LiveCache::Tag::Put: {
+            if (!current.has_value() || op.a.size() != 8) {
+                bad = true;
+                break;
+            }
+            u64 key = 0;
+            for (auto byte : op.a.bytes())
+                key = (key << 8) | byte;
+            items.get(*current)->append({ key, move(op.b) });
+            break;
+        }
+        case LiveCache::Tag::Append: {
+            if (!current.has_value()) {
+                bad = true;
+                break;
+            }
+            auto& list = *items.get(*current);
+            auto last_key = list.is_empty() ? ByteBuffer {} : LiveCache::key_bytes(list.last().key);
+            if (list.is_empty() || last_key.bytes() != op.a.bytes()) {
+                bad = true;
+                break;
+            }
+            list.last().value.append(op.b.bytes());
+            break;
+        }
+        default:
