+    s_live_owner = &self;
+    s_loading = true;
+    u64 highest = 0;
+    for (auto const& name : order) {
+        auto list = self.get_or_create_cache(Utf16String::from_utf8_with_replacement_character(name));
+        auto& entries = *items.get(name);
+        quick_sort(entries, [](auto const& a, auto const& b) { return a.key < b.key; });
+        for (auto& entry : entries) {
