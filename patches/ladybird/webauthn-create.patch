+pub(crate) fn create(cx: &mut CallContext, promise: WebIdlPromise, o: PublicKeyCredentialCreationOptions, signal: Option<Ref<AbortSignal>>) -> WebIdlResult<()> {
+    let mut request = json!({
+        "rp": {"id":o.rp.id.as_ref().map(string), "name":string(&o.rp.name)},
+        "user": {"id":encoded(&o.user.id), "name":string(&o.user.name), "displayName":string(&o.user.display_name)},
+        "challenge":encoded(&o.challenge), "timeout":o.timeout, "attestation":string(&o.attestation),
+        "pubKeyCredParams":o.pub_key_cred_params.iter().map(|p| json!({"type":string(&p.r#type),"alg":p.alg})).collect::<Vec<_>>(),
+    });
+    if let Some(selection) = o.authenticator_selection {
+        request["authenticatorSelection"] = json!({
+            "authenticatorAttachment":selection.authenticator_attachment.as_ref().map(string),
+            "residentKey":selection.resident_key.as_ref().map(string),
+            "requireResidentKey":selection.require_resident_key, "userVerification":string(&selection.user_verification)
+        });
+    }
+    if let Some(list) = o.exclude_credentials { request["excludeCredentials"] = descriptors(cx.vm(), list)?.into(); }
+    begin(cx, promise, signal, request, true)
+}
