+            track.add_range(AK::Duration::from_seconds_f64(MUST(ranges->start(j))), AK::Duration::from_seconds_f64(MUST(ranges->end(j))));
+        highest_end = max(highest_end, track.highest_end_time());
+        tracks.append(move(track));
+    }
