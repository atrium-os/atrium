+    /// Atrium's live pages (I6.7): gives this store's changes to navigatord, in log order. False when one can't be
+    /// given.
+    #[cfg(feature = "atrium-live-idb")]
+    pub(crate) fn send_live_changes(&self, vm: &Vm, store: ObjectStoreRef) -> bool {
+        use crate::indexed_db::internal::live::{Change, send_store_changes};
+        let entries = self.entries.borrow();
+        if entries.is_empty() {
+            return true;
+        }
+        let changes: Vec<Change> = entries
+            .iter()
+            .map(|entry| match entry {
+                Entry::ObjectStoreCreated => Change::StoreCreated,
+                Entry::ObjectStoreDeleted => Change::StoreDeleted,
+                Entry::ObjectStoreRenamed { old_name } => Change::StoreRenamed(old_name),
+                Entry::IndexCreated { index } => Change::IndexCreated(*index),
+                Entry::IndexDeleted { index } => Change::IndexDeleted(*index),
+                Entry::IndexRenamed { index, old_name } => Change::IndexRenamed(*index, old_name),
+                Entry::KeyGeneratorChanged { .. } => Change::KeyGeneratorChanged,
+                Entry::RecordsDeleted { records } => Change::RecordsDeleted(records),
+                Entry::RecordStored { key } => Change::RecordStored(key),
+                Entry::IndexRecordsDeleted { index, records } => Change::IndexRecordsDeleted(*index, records),
+                Entry::IndexRecordStored { index, record } => Change::IndexRecordStored(*index, record),
+            })
+            .collect();
+        // The generator's value after each change of it: the old value of its next change, or its value now.
+        let olds: Vec<u64> = entries
+            .iter()
+            .filter_map(|entry| match entry {
+                Entry::KeyGeneratorChanged { old_value } => Some(*old_value),
+                _ => None,
+            })
+            .collect();
+        let mut after: Vec<u64> = olds.iter().skip(1).copied().collect();
+        if !olds.is_empty() {
+            if !store.uses_a_key_generator() {
+                return false;
+            }
+            after.push(store.key_generator().current_number());
+        }
+        send_store_changes(vm, store, &changes, &after)
+    }
