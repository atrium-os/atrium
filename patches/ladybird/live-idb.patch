+/// A factory is made for `key`: the first time, ask navigatord for the page's store and rebuild it. No mutation log
+/// is open, so nothing is sent back. A failed or out-of-shape load leaves the engine's IndexedDB for this run only.
+pub(crate) fn load(vm: &Vm, key: Option<StorageKey>) {
+    // An opaque origin (the initial about:blank) is not the page's: the load waits for a real one.
+    let Some(key) = key.filter(|key| !key.origin.is_opaque()) else { return };
+    if TRIED.replace(true) {
+        return;
+    }
+    let mut state = Load { vm, key: key.clone(), database: None, store: None, index: None, pending: None, bad: false };
+    // SAFETY: on_op is called only during this call, with ctx the state above.
+    let loaded = unsafe { navigator_live_idb_load((&raw mut state).cast(), on_op) };
+    if !loaded {
+        // navigatord keeps no store for this engine (a frame, a widget): IndexedDB is the run's.
+        return;
+    }
+    state.flush();
+    if state.bad {
+        // Loud, and nothing is sent: commits on top of a partial copy would diverge from navigatord's.
+        eprintln!("live page: the IndexedDB navigatord gave is out of shape; this run keeps IndexedDB for itself");
+        let names: Vec<Utf16String> = Database::for_key(vm, &key).values().iter().map(|database| database.name()).collect();
+        for name in names {
+            Database::delete_for_key_and_name(vm, &key, &name);
+        }
+        return;
+    }
+    PAGE.with_borrow_mut(|page| *page = Some(key));
+}
