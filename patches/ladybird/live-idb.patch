+unsafe extern "C" fn on_op(ctx: *mut c_void, t: u8, a: *const u8, a_len: usize, b: *const u8, b_len: usize, n: u64) {
+    // SAFETY: ctx is the Load that load() lends for the call.
+    let load = unsafe { &mut *ctx.cast::<Load>() };
+    if load.bad {
+        return;
+    }
+    let bytes = |p: *const u8, len: usize| -> &[u8] {
+        if len == 0 || p.is_null() {
+            return &[];
+        }
+        // SAFETY: the engine lends the bytes for this call.
+        unsafe { core::slice::from_raw_parts(p, len) }
+    };
+    if load.apply(t, bytes(a, a_len), bytes(b, b_len), n).is_none() {
+        load.bad = true;
+    }
+}
