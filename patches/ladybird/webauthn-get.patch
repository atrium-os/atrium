+// SPDX-License-Identifier: BSD-2-Clause
+//! Navigator owns the sign-in connection. A single native Promise follows
+//! its request ID until the broker replies or the page aborts.
+use super::{authenticator_assertion_response::AuthenticatorAssertionResponse, authenticator_response::AuthenticatorResponse, credential::Credential};
+use crate::bindings::{CallContext, Exception, WebIdlResult};
+use crate::bindings::interface::{Inherits, Ref, Wrappable, allocate, wrap};
+use crate::bindings::conversions::{BufferSource, BufferSourceRules, UsvString, dictionary_member, dictionary_object, sequence_from_js, to_buffer_source, to_dom_string};
+use crate::bindings::promise::{TaskSource, WebIdlPromise, queue_a_task, reject_promise, reject_promise_with_exception, resolve_promise};
+use crate::dom::abort_signal::AbortSignal;
+use ak::{Utf16String, Utf16StringUnits};
+use libjs_rust::api::{ArrayBuffer, ArrayBufferShared, Gc, PropertyKey, Realm, Trace, Value, Vm};
+use serde_json::{json, Value as Json};
+
+unsafe extern "C" {
+    fn navigator_get_begin(realm: *const core::ffi::c_void, bytes: *const u8, len: usize) -> u32;
+    fn navigator_get_poll(id: u32, buf: *mut u8, len: usize) -> i32;
+    fn navigator_get_abort(id: u32);
+}
+
+pub(crate) struct PublicKeyCredentialRequestOptions {
+    pub(crate) allow_credentials: Option<Value>,
+    pub(crate) challenge: BufferSource,
+    pub(crate) rp_id: Option<Utf16String>,
+    pub(crate) timeout: Option<u32>,
+    pub(crate) user_verification: Utf16String,
+}
+
+#[derive(Trace)]
+#[gc(crate = libjs_rust)]
+pub(crate) struct PublicKeyCredential {
+    credential: Credential,
+    raw: Gc<ArrayBuffer>,
+    assertion: Ref<AuthenticatorAssertionResponse>,
+    attachment: Utf16String,
+}
+impl Wrappable for PublicKeyCredential {}
+impl Inherits<Credential> for PublicKeyCredential {
+    fn parent(&self) -> &Credential { &self.credential }
+}
+impl PublicKeyCredential {
+    pub(crate) fn raw_id(&self, _: &mut CallContext) -> WebIdlResult<Gc<ArrayBuffer>> { Ok(self.raw) }
+    pub(crate) fn response(&self, _: &mut CallContext) -> WebIdlResult<Ref<AuthenticatorAssertionResponse>> { Ok(self.assertion) }
+    pub(crate) fn authenticator_attachment(&self, _: &mut CallContext) -> WebIdlResult<Option<Utf16String>> { Ok(Some(self.attachment.clone())) }
+}
+
+fn string(s: &Utf16String) -> String {
+    match s.as_units() {
+        Utf16StringUnits::Ascii(a) => String::from_utf8_lossy(a).into_owned(),
+        Utf16StringUnits::Latin1(a) => a.iter().copied().map(char::from).collect(),
+        Utf16StringUnits::Utf16(a) => String::from_utf16_lossy(a),
+    }
+}
+fn denied() -> Exception { Exception::Dom("NotAllowedError", Utf16String::from_ascii(b"Credential unavailable")) }
+fn encoded(b: &BufferSource) -> String {
+    // SAFETY: AK encoding allocates ordinary bytes, never JS cells or script.
+    unsafe { b.with_bytes(|bytes| string(&ak::encode_base64(bytes, ak::Base64Alphabet::Base64Url, true))) }
+}
+
+pub(crate) fn get(cx: &mut CallContext, promise: WebIdlPromise, options: PublicKeyCredentialRequestOptions, signal: Option<Ref<AbortSignal>>) -> WebIdlResult<()> {
+    if let Some(s) = signal.filter(|s| s.aborted()) {
+        reject_promise(cx.vm(), promise, s.reason());
+        return Ok(());
+    }
+    let mut request = json!({"challenge":encoded(&options.challenge),"userVerification":string(&options.user_verification)});
+    if let Some(id) = options.rp_id { request["rpId"] = string(&id).into(); }
+    if let Some(ms) = options.timeout { request["timeout"] = ms.into(); }
+    let vm = cx.vm();
+    if let Some(list) = options.allow_credentials {
+        let descriptors = sequence_from_js(vm, list, Vec::new(), |v| {
+            let obj = dictionary_object(vm, v, "PublicKeyCredentialDescriptor")?;
+            let field = |name| dictionary_member(vm, obj, &PropertyKey::from_utf8(name));
+            let id = to_buffer_source(vm, field("id")?.unwrap_or(Value::UNDEFINED), &BufferSourceRules { allow_shared: false, allow_resizable: false })?;
+            let ty = to_dom_string(vm, field("type")?.unwrap_or(Value::UNDEFINED))?;
+            Ok(json!({"type":string(&ty),"id":encoded(&id)}))
+        })?;
+        request["allowCredentials"] = descriptors.into();
+    }
+    let bytes = request.to_string();
+    // SAFETY: begin copies the buffer before returning. Only the host's
+    // current sign-in document realm has a credential channel.
+    let id = unsafe { navigator_get_begin(cx.realm().as_ptr().cast(), bytes.as_ptr(), bytes.len()) };
+    if id == 0 { return Err(denied()); }
+    let pending = Pending { realm: cx.realm(), promise, signal, id };
+    queue_a_task(vm, cx.realm(), TaskSource::UserInteraction, pending, poll);
+    Ok(())
+}
+
+#[derive(Clone, Copy, Trace)]
+#[gc(crate = libjs_rust)]
+struct Pending {
+    realm: Gc<Realm>,
+    promise: WebIdlPromise,
+    signal: Option<Ref<AbortSignal>>,
+    #[gc(untraced)]
+    id: u32,
+}
+
+fn poll(vm: &Vm, p: Pending) {
+    if let Some(s) = p.signal.filter(|s| s.aborted()) {
+        unsafe { navigator_get_abort(p.id) };
+        reject_promise(vm, p.promise, s.reason());
+        return;
+    }
+    let mut bytes = vec![0; 65536];
+    let n = unsafe { navigator_get_poll(p.id, bytes.as_mut_ptr(), bytes.len()) };
+    if n == 0 {
+        queue_a_task(vm, p.realm, TaskSource::UserInteraction, p, poll);
+        return;
+    }
+    let cx = CallContext::new(vm, p.realm);
+    let result = if n > 0 && n as usize <= bytes.len() {
+        decode(&cx, &bytes[..n as usize])
+    } else {
+        let name = match n { -2 => "SecurityError", -3 => "TypeError", _ => "NotAllowedError" };
+        Err(if name == "TypeError" { Exception::type_error("Invalid credential options") } else { Exception::Dom(name, Utf16String::from_ascii(b"Credential unavailable")) })
+    };
+    match result {
+        Ok(credential) => resolve_promise(vm, p.promise, Value::from_object(wrap(&cx, credential))),
+        Err(error) => reject_promise_with_exception(vm, p.promise, error),
+    }
+}
+
+fn decode(cx: &CallContext, bytes: &[u8]) -> WebIdlResult<Ref<PublicKeyCredential>> {
+    let v: Json = serde_json::from_slice(bytes).map_err(|_| denied())?;
+    let buffer = |s: &Json| {
+        let text = Utf16String::from_utf8(s.as_str().ok_or_else(denied)?);
+        let decoded = ak::decode_base64(text.as_units(), ak::Base64Alphabet::Base64Url, ak::LastChunkHandling::Loose, None);
+        if decoded.error.is_some() { return Err(denied()); }
+        Ok(ArrayBuffer::create_from_bytes(cx.vm(), cx.realm(), &decoded.bytes, ArrayBufferShared::No))
+    };
+    let id = v["id"].as_str().filter(|s| s.is_ascii()).ok_or_else(denied)?;
+    let raw = buffer(&v["rawId"])?;
+    let attachment = Utf16String::from_utf8(v["authenticatorAttachment"].as_str().ok_or_else(denied)?);
+    let r = &v["response"];
+    let client_data = buffer(&r["clientDataJSON"])?;
+    let auth = buffer(&r["authenticatorData"])?;
+    let sig = buffer(&r["signature"])?;
+    let user = r.get("userHandle").filter(|v| !v.is_null()).map(buffer).transpose()?;
+    let assertion = allocate(cx.vm(), |_| AuthenticatorAssertionResponse { response: AuthenticatorResponse { client_data }, auth, sig, user });
+    Ok(allocate(cx.vm(), |_| PublicKeyCredential { raw, assertion, attachment, credential: Credential::new(UsvString::from_ascii(id.as_bytes()), "public-key") }))
+}
