+	    READ_SPECIALREG(ich_lr ## x ##_el2));			\
+	if ((eisr & (1u << (x))) != 0)				\
+		WRITE_SPECIALREG(ich_lr ## x ##_el2, 0)
 	STORE_LR(15);
