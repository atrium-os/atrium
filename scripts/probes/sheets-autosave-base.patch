@@ -301,0 +302,23 @@ pub struct Autosave {
+// Measurement-only writer below the normal native serializer and BufWriter.
+struct BaseWrites<'a> {
+    file: &'a mut File,
+    ns: u128,
+    calls: usize,
+}
+impl Write for BaseWrites<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let start = std::time::Instant::now();
+        let result = self.file.write(bytes);
+        self.ns += start.elapsed().as_nanos();
+        self.calls += 1;
+        result
+    }
+    fn flush(&mut self) -> io::Result<()> { self.file.flush() }
+}
+
+fn measured_sync(file: &File) -> io::Result<u128> {
+    let start = std::time::Instant::now();
+    file.sync_all()?;
+    Ok(start.elapsed().as_nanos())
+}
+
